# Wave 6, pillar A. The only genuinely new code in this pillar; everything
# else is one field being carried further.
#
# Deliberately NOT a new routing algorithm. A callout is geometrically the
# same problem as an edge -- two boxes, project each end onto its own outline,
# optional normalized attachment hint on one end -- and edge_router already
# solves it. routeStraight + resolveAttachPoint (layout/edge_router/impl.ts)
# are reused verbatim, which is also what makes a callout's attachment
# convention identical to an edge's rather than merely similar.
#
# It lives under layout/ and not renderer/ despite being consumed by the
# renderer: nothing in it is SVG, every dependency it has is layout/ or
# geometry/, and the editor's drag preview will need the same geometry without
# wanting a renderer import.

file: "packages/core/src/layout/callout_line/impl.ts"
doc: "Geometry for the line from an anchored annotation to the element it points at."

methods: [
  { name: "calloutSections"
    change_type: ADDED
    doc:
      "The line from `annotation` to whatever its anchor names, as edge\n"
      "sections so that the existing edgePath painter can draw it unchanged.\n"
      "\n"
      "Returns an EMPTY array in exactly three cases: (a) the annotation has\n"
      "no anchor; (b) no element in the diagram matches BOTH the anchor's\n"
      "ref_id and its ref_kind; (c) the anchor matches an edge that has no\n"
      "sections. Matching is on the PAIR -- an anchor with ref_kind NODE whose\n"
      "ref_id names a group is case (b), not a group callout.\n"
      "\n"
      "All three of those cases must return empty WITHOUT throwing and without\n"
      "logging anything. Each is a normal state rather than a fault: an\n"
      "unanchored annotation is the common case, and a dangling anchor is what\n"
      "a diagram looks like between deleting a node and dealing with the note\n"
      "about it. Empty is also the useful answer because edgePath already maps\n"
      "an empty section list to an empty path string, so callers need not tell\n"
      "the three apart.\n"
      "\n"
      "Otherwise exactly ONE section, two points, an empty bendPoints array.\n"
      "Straight only: routeOrthogonal exists but a right-angled callout reads\n"
      "as an edge, which is the one thing a callout must not be mistaken for.\n"
      "\n"
      "Target bounds are taken from the element that matched, by ITS kind: a\n"
      "node or group from its position and size; an edge from the union of\n"
      "every section endpoint and bend point, because an edge has no box.\n"
      "\n"
      "Both ends go through edge_router's resolveAttachPoint, which is what\n"
      "makes a callout's attachment identical to an edge's rather than merely\n"
      "similar. The ANNOTATION end is passed no hint and the TARGET's centre\n"
      "as its towardCentre, so it lands where the annotation outline meets the\n"
      "direction of the target centre. The TARGET end is passed\n"
      "`anchor.anchorPosition` as its hint when that field is set and no hint\n"
      "when it is unset, with the ANNOTATION's centre as its towardCentre.\n"
      "\n"
      "Concrete case worth pinning: an annotation at (0,0) size 10x10 anchored\n"
      "to a node at (100,0) size 10x10, no anchorPosition, yields one section\n"
      "from (10,5) to (100,5).\n"
    inputs: [
      { name: "diagram",    type: { named: { symbol: "LaidOutDiagram" } } },
      { name: "annotation", type: { named: { symbol: "LaidOutAnnotation" } } }
    ]
    output: { named: { symbol: "Array", args: [{ named: { symbol: "EdgeSection" } }] } }
    uses: ["routeStraight", "boundsFromRect", "boundsUnion"]
    # Node-or-group bounds-by-id is computed in three other places already
    # (layout_engine endpointBounds, editor preview endpointBounds, svg_painter
    # viewBox). Only the EDGE-target case here is new. Consolidating the four
    # is worth doing and is not this pillar's job.
  }
]
