# Wave 6, pillar A. The consumer -- and the reason the rest of the pillar
# exists. This is the decl that removes the deferral note at impl.ts:166.

file: "packages/core/src/renderer/svg_renderer/impl.ts"
doc: "LaidOutDiagram to a deterministic SVG string."

structs: [
  { name: "SvgRendererImpl"
    change_type: MODIFIED
    methods: [
      { name: "render"
        change_type: MODIFIED
        doc:
          "The annotation pass paints a callout line before the annotation's\n"
          "own shape and text, using calloutSections for the geometry and the\n"
          "existing edgePath painter for the path data.\n"
          "\n"
          "ORDER: the line element is emitted before the shape element within\n"
          "the same annotation group. That ordering is the requirement, not the\n"
          "appearance it produces -- an annotation whose shape has no fill, or\n"
          "a transparent one, will show the line underneath, and that is\n"
          "correct. The reason for the ordering is that where the shape IS\n"
          "opaque the line must not be drawn across its text, which is the same\n"
          "reason edges are painted before nodes.\n"
          "\n"
          "STYLING: from the annotation's `callout` Glyph1D, through the same\n"
          "painter helpers the edge pass uses. Concretely, a callout and an\n"
          "edge carrying an equal Glyph1D must emit equal stroke, stroke-width\n"
          "and marker attributes -- not merely analogous ones.\n"
          "\n"
          "MARKERS: the arrowhead-variant scan that feeds arrowMarkers must\n"
          "WIDEN to include callouts. It currently walks edges only, so a\n"
          "marker a callout asks for is only defined when some edge happens to\n"
          "want the same variant -- and a diagram with one anchored annotation\n"
          "and no edges emits no defs at all, leaving marker-end pointing at\n"
          "nothing. Include the `callout.arrowheads` of every annotation that\n"
          "produces a non-empty section list. Still ONE shared marker set and\n"
          "one id scheme; a callout and an edge asking for the same variant\n"
          "share a def.\n"
          "\n"
          "IDENTITY: the line stays inside the existing\n"
          "`<g id=\"annotation-...\">` element and carries no data-element-id\n"
          "and no hit stroke of its own, because it is decoration and the\n"
          "annotation is the element.\n"
          "\n"
          "That is for consumers of the SVG, and is NOT what determines\n"
          "selection in the editor. The editor does not hit-test this markup at\n"
          "all: scene/hit_test walks the bounds index and the DiagramLayer\n"
          "string is inert. So a click along the part of the line that lies\n"
          "outside the annotation's bounds selects whatever the bounds index\n"
          "reports at that point, which may be nothing or an enclosing group.\n"
          "(The line's first endpoint sits ON the annotation outline, so a\n"
          "click there does select the annotation -- by bounds, not by markup.)\n"
          "\n"
          "EMPTY: whenever calloutSections returns an empty array, for any of\n"
          "the three reasons it documents, the path string is empty and no line\n"
          "element is emitted at all. The unanchored case is by far the most\n"
          "common of the three.\n"
          "\n"
          "Remove the deferral NOTE that currently sits above the annotation\n"
          "loop; it describes exactly the gap this decl closes.\n"
        inputs: [{ name: "diagram", type: { named: { symbol: "LaidOutDiagram" } } }]
        output: { named: { symbol: "archeglyph.util.Result", args: [
          { primitive: CHARACTER },
          { named: { symbol: "RenderError" } }
        ]}}
        uses: ["calloutSections", "edgePath", "shapePath", "textElement"]
      }
    ]
  }
]
