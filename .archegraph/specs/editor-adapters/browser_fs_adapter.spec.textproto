# MODIFIED (wave 1 "editor-adapters Δ"). Two changes:
#
# 1. canSave() becomes handle-aware: `return this.styleHandle !== null ||
#    this.diagHandle !== null;` instead of the current unconditional `true`.
#    Fixes a real bug (docs/editor-ui-review.md §2.10): today canSave() lies
#    before any file is opened, so autosave calls showSaveFilePicker from a
#    timer with no user gesture and silently fails forever.
#
# 2. load() and save() each wrap their existing body in one top-level
#    try/catch and return Result instead of throwing/returning bare values.
#    On success: Ok(result). On any caught error (including the existing
#    `throw new Error(...)` calls in loadViaFsa/loadViaInput, which now
#    propagate up to be caught here): Err(Object.assign(new AdapterError(),
#    { message: e instanceof Error ? e.message : String(e) })). The private
#    helper methods (loadViaFsa, loadOptionalHandle, loadViaInput, saveViaFsa,
#    saveViaDownload, computeStyleName) and the two module-level helper
#    functions (loadOptionalFile, pickFilesViaInput) are UNCHANGED — they may
#    keep throwing plain Error; only the two public boundary methods gain the
#    try/catch + Result wrapping.

file: "packages/editor/src/adapters/browser_fs_adapter.ts"
doc: "BrowserFsAdapter — HostAdapter via browser File System Access API."

structs: [
  { name: "BrowserFsAdapter"
    change_type: MODIFIED
    doc:
      "Uses window.showOpenFilePicker to let the user pick a .diag.json file.\n"
      "Looks for a sibling .style.json (same basename, same directory) and loads\n"
      "it if present. canSave reflects whether a file handle has actually been\n"
      "acquired (from a prior load or save) — true only once the browser has\n"
      "granted a real writable handle. Firefox/Safari degrade to read-only via\n"
      "input[type=file] fallback for load, download fallback for save.\n"
      "Architecture §4.3."
    implements: [{ named: { symbol: "HostAdapter" } }]
    methods: [
      { name: "canSave"
        doc: "`this.styleHandle !== null || this.diagHandle !== null` — true once ANY real file handle exists."
        output: { primitive: BOOLEAN }
      },
      { name: "load"
        doc: "Wrap the existing dispatch-to-loadViaFsa/loadViaInput body in try/catch; return Result."
        is_async: true
        output: { named: { symbol: "archeglyph.util.Result", args: [
          { named: { symbol: "LoadResult" } },
          { named: { symbol: "AdapterError" } }
        ]}}
      },
      { name: "save"
        doc: "Wrap the existing dispatch-to-saveViaFsa/saveViaDownload body in try/catch; return Result."
        is_async: true
        inputs: [{ name: "stylesheet", type: { named: { symbol: "archeglyph.style.v1.Stylesheet" } } }]
        output: { named: { symbol: "archeglyph.util.Result", args: [
          { primitive: VOID },
          { named: { symbol: "AdapterError" } }
        ]}}
      }
    ]
    typescript: {}
  }
]
