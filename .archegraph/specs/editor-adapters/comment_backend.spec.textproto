# MODIFIED (wave 1 "editor-adapters Δ"): both methods return
# Promise<Result<T, AdapterError>> instead of a bare Promise<T>, matching
# HostAdapter's boundary-method convention (see host_adapter.spec.textproto).

file: "packages/editor/src/adapters/comment_backend.ts"
doc: "CommentBackend contract and ThreadEntry helper type."

structs: [
  { name: "ThreadEntry"
    doc:
      "A CommentThread paired with the StyleEdit id it belongs to.\n"
      "Element type of fetchThreads() return."
    fields: [
      { name: "editRef", type: { primitive: CHARACTER } },
      { name: "thread",  type: { named: { symbol: "archeglyph.style.v1.CommentThread" } } }
    ]
    typescript: {}
  }
]

interfaces: [
  { name: "CommentBackend"
    doc:
      "Persistence for comment threads. Each thread is anchored to a StyleEdit\n"
      "by editRef (the StyleEdit id). Boundary interface: implementations never\n"
      "throw — FileBackend resolves synchronously internally so its Result is\n"
      "always Ok; the future git-forge backends wrap real network calls and can\n"
      "genuinely Err. Architecture §4.4."
    methods: [
      { name: "fetchThreads"
        doc: "Load all threads across all edits. One ThreadEntry per StyleEdit that has comments."
        is_async: true
        output: { named: { symbol: "archeglyph.util.Result", args: [
          { named: { symbol: "Array", args: [{ named: { symbol: "ThreadEntry" } }] } },
          { named: { symbol: "AdapterError" } }
        ]}}
      },
      { name: "postComment"
        doc: "Append a Comment to the thread for editRef. Creates the thread entry if absent."
        is_async: true
        inputs: [
          { name: "editRef",  type: { primitive: CHARACTER } },
          { name: "comment",  type: { named: { symbol: "archeglyph.style.v1.Comment" } } }
        ]
        output: { named: { symbol: "archeglyph.util.Result", args: [
          { primitive: VOID },
          { named: { symbol: "AdapterError" } }
        ]}}
      }
    ]
  }
]
