file: "packages/editor/src/adapters/file_backend.ts"
doc: "FileBackend — CommentBackend backed by Stylesheet.pending_edits[].thread."

structs: [
  { name: "FileBackend"
    doc:
      "Reads and writes comment threads directly from the in-memory stylesheet.\n"
      "Constructed with a SolidJS Accessor<Stylesheet> and Setter<Stylesheet>\n"
      "(the EditorState stylesheet getter and an updater callback). fetchThreads\n"
      "walks pending_edits and collects entries whose thread is non-empty.\n"
      "postComment splices into the matching thread (or creates one) and calls\n"
      "the setter so the signal updates. No network calls. Architecture §4.4."
    implements: [{ named: { symbol: "CommentBackend" } }]
    methods: [
      { name: "fetchThreads"
        is_async: true
        output: { named: { symbol: "Array", args: [{ named: { symbol: "ThreadEntry" } }] } }
      },
      { name: "postComment"
        is_async: true
        inputs: [
          { name: "editRef",  type: { primitive: CHARACTER } },
          { name: "comment",  type: { named: { symbol: "archeglyph.style.v1.Comment" } } }
        ]
        output: { primitive: VOID }
      }
    ]
    typescript: {}
  }
]
