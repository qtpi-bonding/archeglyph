file: "packages/editor/src/adapters/github_pr_backend.ts"
doc: "GitHubPrBackend — CommentBackend backed by GitHub PR comments."

structs: [
  { name: "GitHubPrBackend"
    doc:
      "Constructed with a GitHubAuth instance and a pr string ('owner/repo/123').\n"
      "fetchThreads: GET /repos/{owner}/{repo}/pulls/{n}/comments, scan each body\n"
      "for ```archeglyph envelope blocks, parse JSON, group by edit_ref into ThreadEntry[].\n"
      "postComment: POST a new GitHub PR comment whose body embeds the §13.6\n"
      "envelope: { schema_version:1, kind:'comment', edit_ref, payload: Comment }.\n"
      "Anonymous fallback (getToken()==null) uses unauthenticated GitHub API\n"
      "(60 req/hr limit, public repos only). Design §13.5–13.6."
    implements: [{ named: { symbol: "CommentBackend" } }]
    methods: [
      { name: "fetchThreads"
        is_async: true
        output: { named: { symbol: "Array", args: [{ named: { symbol: "ThreadEntry" } }] } }
        uses: ["GitHubAuth"]
      },
      { name: "postComment"
        is_async: true
        inputs: [
          { name: "editRef",  type: { primitive: CHARACTER } },
          { name: "comment",  type: { named: { symbol: "archeglyph.style.v1.Comment" } } }
        ]
        output: { primitive: VOID }
        uses: ["GitHubAuth"]
      }
    ]
    typescript: {}
  }
]
