# MODIFIED (wave 1 of docs/implementation-order.md, "editor-adapters Δ"):
# every public HostAdapter method now returns Promise<Result<T, AdapterError>>
# instead of throwing. This is the "no throw outside boundary functions" rule —
# HostAdapter.load/save ARE the boundary (the only place editor UI code calls
# into host-specific browser APIs / network fetches), so each implementation's
# public load()/save() wraps its whole body in one try/catch and converts any
# caught error to Err(AdapterError). Internal private helpers (loadViaFsa,
# saveViaDownload, etc. in BrowserFsAdapter) may keep throwing plain Error —
# only the PUBLIC boundary method needs the try/catch, not every helper.

file: "packages/editor/src/adapters/host_adapter.ts"
doc: "HostAdapter contract, LoadResult data shape, and the shared AdapterError type."

structs: [
  { name: "LoadResult"
    doc:
      "Return value of HostAdapter.load(). Diagram always present;\n"
      "stylesheet absent when no style file found — caller defaults to empty."
    fields: [
      { name: "diagram",    type: { named: { symbol: "archeglyph.content.v1.Diagram" } } },
      { name: "stylesheet", type: { named: { symbol: "archeglyph.style.v1.Stylesheet" } }, is_optional: true }
    ]
    typescript: {}
  },
  { name: "AdapterError"
    doc:
      "Shared error value for every editor-adapters boundary method (HostAdapter\n"
      "and CommentBackend). One field, `message`, built from whatever was caught\n"
      "(`e instanceof Error ? e.message : String(e)`) or a boundary-specific\n"
      "message (e.g. \"No .diag.json file selected\")."
    fields: [
      { name: "message", type: { primitive: CHARACTER } }
    ]
    typescript: {}
  }
]

interfaces: [
  { name: "HostAdapter"
    doc:
      "Load/save abstraction over a diagram+style file pair. Implementations\n"
      "decide where files live (local FS, URL params, remote fetch). canSave\n"
      "controls whether the editor UI offers a Save button — implementations\n"
      "must make it reflect real save-ability (e.g. BrowserFsAdapter.canSave()\n"
      "is handle-aware, not an unconditional true) so the UI never offers Save\n"
      "when a save would fail. Architecture §4.3."
    methods: [
      { name: "canSave"
        doc: "True if this adapter supports writing stylesheet changes back RIGHT NOW."
        output: { primitive: BOOLEAN }
      },
      { name: "load"
        doc: "Fetch diagram and optionally stylesheet. stylesheet absent = undefined. Boundary method: never throws."
        is_async: true
        output: { named: { symbol: "archeglyph.util.Result", args: [
          { named: { symbol: "LoadResult" } },
          { named: { symbol: "AdapterError" } }
        ]}}
      },
      { name: "save"
        doc: "Persist the current stylesheet. Only called when canSave() is true. Boundary method: never throws."
        is_async: true
        inputs: [{ name: "stylesheet", type: { named: { symbol: "archeglyph.style.v1.Stylesheet" } } }]
        output: { named: { symbol: "archeglyph.util.Result", args: [
          { primitive: VOID },
          { named: { symbol: "AdapterError" } }
        ]}}
      }
    ]
  }
]
