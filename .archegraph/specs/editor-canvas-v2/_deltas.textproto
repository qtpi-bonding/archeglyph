# Brownfield deletes for the canvas rewrite (wave 3).
#
# Two whole files retire. Both are superseded by modules that already exist
# and are verified, so this is removal, not migration:
#
#   drag_handler.ts — the drag preview it computed is now scene/preview's
#     ScenePreview, drawn by overlay_layer. Its commit-on-pointer-up path
#     is finding §2.1 (a plain click writes a position edit and teleports
#     the node to 0,0); nothing replaces it in this wave, and wave 4's
#     move_gesture + move_edit builder replace it properly.
#
#   viewport.ts — replaced by ui_state's Viewport + viewport_math (wave 2,
#     merged), which take a ContainerRect and so fix finding §2.16. Its
#     local Vec2 is the second definition of that type in the repo
#     (docs/relaxing-koine-constraints.md §3.3); core/geometry's is the
#     survivor.
#
# canvas/selection.ts deliberately SURVIVES this pillar — inspector.tsx
# still consumes useSelection and the numeric ElementKind enum, and that
# migration belongs to inspector v2 in wave 5. See app.spec.textproto for
# the one-way bridge that keeps it consistent meanwhile.

node_deltas: [
  # drag_handler.ts — entire file
  { symbol: "packages/editor/src/canvas/drag_handler.ts/DragSession#"                  change_type: DELETED },
  { symbol: "packages/editor/src/canvas/drag_handler.ts/DragHandler#"                  change_type: DELETED },
  { symbol: "packages/editor/src/canvas/drag_handler.ts/DragHandler#dragOffset()."     change_type: DELETED },
  { symbol: "packages/editor/src/canvas/drag_handler.ts/DragHandler#activeSession()."  change_type: DELETED },
  { symbol: "packages/editor/src/canvas/drag_handler.ts/DragHandler#onPointerDown()."  change_type: DELETED },
  { symbol: "packages/editor/src/canvas/drag_handler.ts/DragHandler#onPointerMove()."  change_type: DELETED },
  { symbol: "packages/editor/src/canvas/drag_handler.ts/DragHandler#onPointerUp()."    change_type: DELETED },

  # viewport.ts — entire file
  { symbol: "packages/editor/src/canvas/viewport.ts/Vec2#"                   change_type: DELETED },
  { symbol: "packages/editor/src/canvas/viewport.ts/ViewportState#"          change_type: DELETED },
  { symbol: "packages/editor/src/canvas/viewport.ts/ViewportState#toCanvas()." change_type: DELETED },
  { symbol: "packages/editor/src/canvas/viewport.ts/ViewportState#toScreen()." change_type: DELETED }
]
