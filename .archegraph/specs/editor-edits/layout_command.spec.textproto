# Wave 3. The commands that operate on pinning itself rather than on one
# element: Pin all, Unpin all, Auto-layout.
#
# Because a pin IS a written NodeLayout.position (see move), these are all
# the same two operations: copy the Scene's computed positions into the
# stylesheet, or remove them. That is why they need a LaidOutDiagram and the
# other builders do not — pinning everything means writing down where ELK
# just put it.
#
# Wave 5's `layout` Δ is the other half: once every node is pinned it skips
# ELK entirely, which is what makes a pinned diagram stable.

file: "packages/editor/src/state/edits/layout_command.ts"
doc: "Pin all, unpin all and auto-layout — the commands that operate on pinning rather than on one element."

methods: [
  { name: "pinAllEdit"
    doc:
      "Writes every laid-out node's and group's current position into the\n"
      "stylesheet, freezing the diagram exactly as it looks.\n"
      "\n"
      "Positions come out of LaidOutDiagram canvas-absolute and go into the\n"
      "stylesheet parent-relative, so a child's position has its parent\n"
      "group's subtracted. Getting this backwards is the §5.1 bug in reverse\n"
      "and would throw every grouped node out by its group's offset.\n"
      "\n"
      "Already-pinned elements are rewritten with the same value rather than\n"
      "skipped: the result should be one edit that makes the whole diagram\n"
      "pinned, whatever it was before."
    inputs: [
      { name: "stylesheet", type: { named: { symbol: "archeglyph.style.v1.Stylesheet" } } },
      { name: "diagram", type: { named: { symbol: "LaidOutDiagram" } } }
    ]
    output: { named: { symbol: "archeglyph.style.v1.StyleEdit" } }
    uses: ["patchNodeEntry", "patchGroupEntry", "nodeChange", "groupChange", "styleEdit"]
  },
  { name: "withLayoutMaterialized"
    doc:
      "Pin-on-touch (docs/editor-ui-review.md §5.2). Returns `edit` with a\n"
      "position written for every node and group that has none yet, taken\n"
      "from where the layout currently puts them.\n"
      "\n"
      "Why this is not optional: an un-pinned diagram is arranged by ELK, but\n"
      "the moment ONE element gets a position the layout engine stops asking\n"
      "ELK for placement and seeds the rest beside the pinned one instead. So\n"
      "without this, dragging a single node rearranges the whole diagram\n"
      "under the user. Every builder that writes a position — move, resize,\n"
      "nudge — must route through here.\n"
      "\n"
      "The materialized changes come FIRST, so the caller's own changes win\n"
      "for any element they also touch (applyMapChanges takes the last change\n"
      "per id). One edit, so it is one undo entry.\n"
      "\n"
      "Elements that already carry a position in the stylesheet are skipped,\n"
      "which makes this a no-op from the second gesture onwards; when nothing\n"
      "needs pinning it returns `edit` unchanged."
    inputs: [
      { name: "stylesheet", type: { named: { symbol: "archeglyph.style.v1.Stylesheet" } } },
      { name: "diagram", type: { named: { symbol: "LaidOutDiagram" } } },
      { name: "edit", type: { named: { symbol: "archeglyph.style.v1.StyleEdit" } } }
    ]
    output: { named: { symbol: "archeglyph.style.v1.StyleEdit" } }
    uses: ["patchNodeEntry", "patchGroupEntry", "nodeChange", "groupChange", "initOf"]
  },
  { name: "unpinAllEdit"
    doc: "Clears every NodeLayout/GroupLayout position, handing the diagram back to ELK. Keeps the rest of each entry — unpinning must not reset anyone's colours."
    inputs: [
      { name: "stylesheet", type: { named: { symbol: "archeglyph.style.v1.Stylesheet" } } }
    ]
    output: { named: { symbol: "archeglyph.style.v1.StyleEdit" } }
    uses: ["nodeChange", "groupChange", "styleEdit"]
    # Corrected post-build: clearing a pin cannot go through patchNodeEntry /
    # patchGroupEntry, because a patch only ever WRITES fields. Unpinning
    # builds an entry that simply does not have the position, via the
    # file-local withoutNodePosition / withoutGroupPosition.
    #
    # The schema DOES have an unset channel — NodeStyleChange.unset_paths
    # (proto/style.proto:514, "explicit field-clearing") — and the build's
    # first attempt used it. Nothing in the repo implements it: applyMapChanges
    # in state/apply_style_edit.ts ignores the field completely, so unpinning
    # silently did nothing. Using it is correct against the schema and broken
    # against every consumer, which is worse than not having it. Until some
    # consumer honours unset_paths, clear a field by omitting it.
  },
  { name: "unpinElementsEdit"
    doc: "Same, for a selection — 'let ELK decide where these go again'."
    inputs: [
      { name: "stylesheet", type: { named: { symbol: "archeglyph.style.v1.Stylesheet" } } },
      { name: "refs", type: { named: { symbol: "Array", args: [{ named: { symbol: "ElementMove" } }] } } }
    ]
    output: { named: { symbol: "archeglyph.style.v1.StyleEdit" } }
    uses: ["nodeChange", "groupChange", "styleEdit"]
    # Same correction as unpinAllEdit. Annotations in `refs` are skipped:
    # they are always explicitly positioned, so there is no auto-layout for an
    # unpinned one to fall back to.
  }
]
