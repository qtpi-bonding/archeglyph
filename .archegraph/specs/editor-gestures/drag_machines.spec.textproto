# Wave 4. The three drags, as pure functions of (where it started, where the
# pointer is now). No signals, no event objects, no accumulated mutable state
# beyond the session struct the caller holds — so every awkward case is a unit
# test rather than something you have to reproduce with a mouse.
#
# Each machine has the same shape: begin() captures what the gesture needs from
# the world once, update() maps a current pointer position to a preview, and
# commit() produces the durable result. Only commit() reaches the document, and
# it goes through state/edits like every other change, so a drag lands in the
# undo log as one entry.

file: "packages/editor/src/gestures/drag_machines.ts"
doc: "Pan, move and marquee as pure begin/update/commit functions over a captured session."

structs: [
  { name: "PanSession"
    fields: [
      { name: "origin", type: { named: { symbol: "Vec2" } } },
      { name: "viewport", type: { named: { symbol: "Viewport" } } }
    ]
    typescript: { struct_kind: STRUCT_KIND_INTERFACE }
  },
  { name: "MoveSession"
    doc:
      "`refs` is what is being dragged and `origin` where the pointer started,\n"
      "both captured at begin. The starting bounds are NOT captured: they are\n"
      "read from the live geometry on each update, so a scene rebuilt\n"
      "mid-drag does not leave the preview anchored to a stale rectangle."
    fields: [
      { name: "refs", type: { named: { symbol: "Array", args: [{ named: { symbol: "ElementRef" } }] } } },
      { name: "origin", type: { named: { symbol: "Vec2" } } }
    ]
    typescript: { struct_kind: STRUCT_KIND_INTERFACE }
  },
  { name: "MarqueeSession"
    fields: [
      { name: "origin", type: { named: { symbol: "Vec2" } } }
    ]
    typescript: { struct_kind: STRUCT_KIND_INTERFACE }
  }
]

methods: [
  { name: "panUpdate"
    doc: "Screen delta straight onto the viewport's pan. Not scaled by zoom — the content should track the pointer one-to-one on screen, which is what panning means."
    inputs: [
      { name: "session", type: { named: { symbol: "PanSession" } } },
      { name: "current", type: { named: { symbol: "Vec2" } } }
    ]
    output: { named: { symbol: "Viewport" } }
  },
  { name: "moveUpdate"
    doc:
      "The live preview for a move. Converts the screen delta to DIAGRAM units\n"
      "by dividing by zoom — dragging 100 screen pixels at 2x zoom must move\n"
      "the element 50 diagram units, or the shape will not stay under the\n"
      "pointer.\n"
      "\n"
      "Returns a ScenePreview rather than mutating anything: overlay_layer\n"
      "draws it and diagram_layer dims the originals, which is the approved\n"
      "drawing model. Nothing touches the injected renderer SVG."
    inputs: [
      { name: "session", type: { named: { symbol: "MoveSession" } } },
      { name: "geometry", type: { named: { symbol: "SceneGeometry" } } },
      { name: "current", type: { named: { symbol: "Vec2" } } },
      { name: "zoom", type: { primitive: REAL } }
    ]
    output: { named: { symbol: "ScenePreview" } }
    uses: ["previewMove"]
  },
  { name: "moveCommit"
    doc:
      "The StyleEdit for a finished move, or undefined when nothing actually\n"
      "moved (a zero delta must not write an edit — that is what puts a no-op\n"
      "in the undo history).\n"
      "\n"
      "THE TRAP: geometry is canvas-absolute, and NodeLayout.position is\n"
      "PARENT-RELATIVE (design.md §5.3). An element inside a group must have\n"
      "its group's absolute position subtracted before the value is written,\n"
      "or every grouped element jumps by its group's offset the moment the\n"
      "scene rebuilds. That is finding §5.1 in reverse, and the reason\n"
      "ElementBounds carries parentGroup at all.\n"
      "\n"
      "Edges are skipped: a route is a consequence of its endpoints."
    inputs: [
      { name: "session", type: { named: { symbol: "MoveSession" } } },
      { name: "geometry", type: { named: { symbol: "SceneGeometry" } } },
      { name: "stylesheet", type: { named: { symbol: "archeglyph.style.v1.Stylesheet" } } },
      { name: "current", type: { named: { symbol: "Vec2" } } },
      { name: "zoom", type: { primitive: REAL } }
    ]
    output: { unsupported: { reason: RAW_EXPRESSION, source_excerpt: "StyleEdit | undefined" } }
    uses: ["moveElementsEdit", "withLayoutMaterialized", "elementKey", "archeglyph.style.v1.StyleEdit"]
  },
  { name: "marqueeUpdate"
    doc: "The rectangle between the press point and the pointer, in diagram units, normalised so dragging up-left gives the same rect as down-right."
    inputs: [
      { name: "session", type: { named: { symbol: "MarqueeSession" } } },
      { name: "current", type: { named: { symbol: "Vec2" } } }
    ]
    output: { named: { symbol: "Bounds" } }
  },
  { name: "marqueeCommit"
    doc: "Everything the rectangle touches. Intersection, not containment — a marquee that only selects fully-enclosed elements feels broken on a diagram of wide nodes."
    inputs: [
      { name: "geometry", type: { named: { symbol: "SceneGeometry" } } },
      { name: "marquee", type: { named: { symbol: "Bounds" } } }
    ]
    output: { named: { symbol: "Array", args: [{ named: { symbol: "ElementRef" } }] } }
    uses: ["selectInRect"]
  }
]
