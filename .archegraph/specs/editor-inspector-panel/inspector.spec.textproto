# Wave 5. The panel itself: routes by selection, renders the sections the
# model names, and hands each field's commit to state.applyStyleEdit.
#
# This REPLACES packages/editor/src/shell/inspector.tsx, which is deleted in
# the same build. The old one reads selection from canvas/selection.ts -- the
# single-element SelectionContext that wave 3 was supposed to retire and that
# app.tsx still maintains a bridge for solely to keep it alive.

file: "packages/editor/src/inspector/inspector.tsx"
doc: "The inspector panel: selection -> sections -> fields -> one StyleEdit per commit."

constants: [
  { name: "Inspector"
    doc:
      "Reads ui.selection() and the scene, builds an InspectorModel, and\n"
      "renders the sections it names. No selection, or a mixed-kind one,\n"
      "shows a line of text rather than an empty form.\n"
      "\n"
      "Every commit goes through state.applyStyleEdit with the edit from\n"
      "commitLayout or commitTypography, and an undefined edit is dropped.\n"
      "One commit, one undo entry.\n"
      "\n"
      "SOLID: the model must be a memo or an accessor called in the JSX, not\n"
      "a value computed in the component body. A component body runs once, so\n"
      "a model read there would freeze at the mount-time selection -- the\n"
      "mistake overlay_layer's handle code documents.\n"
      "\n"
      "Focus: the root is focusable and the first field carries a ref the\n"
      "focus-inspector command uses. Escape anywhere in the panel returns\n"
      "focus to the canvas WITHOUT clearing the selection, which is the\n"
      "difference between leaving the inspector and deselecting. Inside a\n"
      "field that same keypress also restores the field's pre-focus value\n"
      "first; see NumberFieldInput, which owns that half."
    type: { unsupported: { reason: RAW_EXPRESSION, source_excerpt: "Component<InspectorProps>" } }
    uses: [
      "inspectorModel", "layoutModel", "typographyModel", "commitLayout",
      "commitTypography", "NumberFieldInput", "ColorFieldInput", "TokenFieldInput"
    ]
  }
]

structs: [
  { name: "InspectorProps"
    doc: "The three things the panel reads. `theme` supplies the token names TokenFieldInput offers."
    fields: [
      { name: "state", type: { named: { symbol: "EditorState" } } },
      { name: "ui", type: { named: { symbol: "UiState" } } },
      { name: "geometry", type: { named: { symbol: "SceneGeometry" } }, is_optional: true },
      { name: "theme", type: { named: { symbol: "Theme" } } }
    ]
    typescript: { struct_kind: STRUCT_KIND_INTERFACE }
  }
]
