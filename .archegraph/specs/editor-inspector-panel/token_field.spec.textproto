constants: [
  { name: "TokenFieldInput"
    doc:
      "A text input wired to a <datalist> of props.tokens, so tokens are\n"
      "offered first and a literal stays typeable. Commit on blur and Enter,\n"
      "Escape restores and leaves, mixed shows 'Mixed'.\n"
      "\n"
      "The local signal holds typed text; onInput updates it and nothing\n"
      "else; onBlur commits that signal's current value. An onBlur that\n"
      "commits a constant would clear the field every time focus left it.\n"
      "\n"
      "The token list arrives as a prop. This file renders; it does not read\n"
      "a theme or resolve anything."
    type: { unsupported: { reason: RAW_EXPRESSION, source_excerpt: "Component<TokenFieldProps>" } }
  }
