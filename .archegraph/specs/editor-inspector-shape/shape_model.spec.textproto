# Wave 5 follow-on. The Shape section's READ half. The write half is in
# shape_commit.ts, one decl per file, because a node is per decl and a merge
# is per file.

file: "packages/editor/src/inspector/models/shape_model.ts"
doc: "Reads the editable subset of Glyph2D for the Shape section."

structs: [
  { name: "ShapeModel"
    doc: "`shape` carries a DISPLAY NAME -- 'rect', 'ellipse', 'hexagon' -- not the numeric enum value. SHAPE_TABLE in shape_names.ts is where those names come from."
    fields: [
      { name: "shape", type: { named: { symbol: "TextField" } } },
      { name: "cornerRadius", type: { named: { symbol: "NumberField" } } },
      { name: "fill", type: { named: { symbol: "TextField" } } },
      { name: "strokeColor", type: { named: { symbol: "TextField" } } },
      { name: "strokeWidth", type: { named: { symbol: "NumberField" } } }
    ]
    typescript: { struct_kind: STRUCT_KIND_INTERFACE }
  }
]

methods: [
  { name: "shapeModel"
    doc:
      "Overrides from the entry's `shape`; effective values from the laid-out\n"
      "element's `shape`, which the resolver has cascaded and token-resolved.\n"
      "Folds with numberField and textField.\n"
      "\n"
      "Serves node, group and annotation -- the three kinds with a Glyph2D.\n"
      "An edge has none and never reaches here.\n"
      "\n"
      "SHAPE_UNSPECIFIED reads as NO value, not as a name. The zero value\n"
      "means 'renderer picks', which is what an absent override already\n"
      "means, and offering it as a selectable name would let the user write a\n"
      "value that means nothing.\n"
      "\n"
      "PAINT IS A ONEOF. Stroke.paint and Fill.paint are protobuf oneofs of\n"
      "color|gradient, so there is no `stroke.color` field -- read\n"
      "`stroke?.paint?.case === 'color' ? stroke.paint.value?.value :\n"
      "undefined`. A gradient therefore contributes undefined to the colour\n"
      "fields, which reads as unset. That is honest: there is no colour to\n"
      "show. It also means an unset-LOOKING colour field can be hiding a\n"
      "gradient; commitShape owns that consequence."
    inputs: [
      { name: "model", type: { named: { symbol: "InspectorModel" } } },
      { name: "geometry", type: { named: { symbol: "SceneGeometry" } } },
      { name: "stylesheet", type: { named: { symbol: "Stylesheet" } } }
    ]
    output: { named: { symbol: "ShapeModel" } }
    uses: ["numberField", "textField", "SHAPE_TABLE"]
  }
]
