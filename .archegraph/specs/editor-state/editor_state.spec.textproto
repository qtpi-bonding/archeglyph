file: "packages/editor/src/state/editor_state.ts"
doc:
  "EditorState interface — the reactive contract the canvas, inspector,\n"
  "and toolbar consume. SolidJS-signal-backed: every accessor is a Solid\n"
  "Accessor (() => T) that tracks when read inside a reactive context.\n"
  "One instance per file session; dispose and recreate on file reload.\n"
  "createEditorState() is the only factory — never construct directly."

interfaces: [
  { name: "EditorState"
    change_type: MODIFIED
    doc:
      "Reactive handle for one editor session. Diagram is read-only\n"
      "(topology never changes inside the editor). Stylesheet is mutated\n"
      "only through applyStyleEdit — no direct signal mutation from outside."
    methods: [
      { name: "diagram"
        doc: "Solid Accessor. Returns the loaded Diagram proto. Call inside a reactive context to track."
        output: { named: { symbol: "archeglyph.content.v1.Diagram" } }
      },
      { name: "stylesheet"
        doc: "Solid Accessor. Returns the current Stylesheet, updated on every applyStyleEdit call."
        output: { named: { symbol: "archeglyph.style.v1.Stylesheet" } }
      },
      { name: "canUndo"
        doc: "Solid Accessor. True when the in-memory undo log has at least one entry."
        output: { primitive: BOOLEAN }
      },
      { name: "canRedo"
        doc: "Solid Accessor. True when the in-memory redo log has at least one entry."
        output: { primitive: BOOLEAN }
      },
      { name: "dirty"
        doc:
          "Solid Accessor, ADDED (wave 1 editor-state Δ). True once any\n"
          "applyStyleEdit/undo/redo has run this session. No reset hook yet —\n"
          "a future save-controller pillar (docs/implementation-order.md wave 2\n"
          "'save_controller') will need a way to mark clean after a successful\n"
          "save; out of scope here."
        output: { primitive: BOOLEAN }
      },
      { name: "version"
        doc:
          "Solid Accessor, ADDED (wave 1 editor-state Δ). Monotonic counter,\n"
          "incremented once per applyStyleEdit/undo/redo call. Lets consumers\n"
          "(e.g. a future Scene memo) depend on 'the stylesheet changed' without\n"
          "depending on the Stylesheet value itself."
        output: { primitive: INTEGER }
      },
      { name: "applyStyleEdit"
        doc:
          "MODIFIED: second param `coalesceKey?: string` added. Apply a\n"
          "StyleEdit (APPLIED state path). Snapshots before-state for the\n"
          "changed element IDs, writes after-states into the stylesheet\n"
          "signal, pushes {beforeSnapshot, edit, tsMs, coalesceKey} to the undo\n"
          "log via undo_log.ts's pushUndoEntry (coalesces into the previous\n"
          "entry when coalesceKey matches and the coalesce window hasn't\n"
          "elapsed), clears redo log. Bumps dirty/version."
        change_type: MODIFIED
        inputs: [
          { name: "edit", type: { named: { symbol: "archeglyph.style.v1.StyleEdit" } } },
          { name: "coalesceKey", type: { primitive: CHARACTER }, is_optional: true }
        ]
        output: { primitive: VOID }
      },
      { name: "undo"
        doc: "Restore before-snapshot from the top of the undo log. Pushes to redo log. No-op when canUndo is false. Bumps version."
        output: { primitive: VOID }
      },
      { name: "redo"
        doc: "Re-apply edit from the top of the redo log. Pushes back to undo log. No-op when canRedo is false. Bumps version."
        output: { primitive: VOID }
      }
    ]
  }
]
