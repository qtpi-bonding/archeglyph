        },
        {
          "name": "no-nodes-external",
          "condition": "No ViewNode has is_external=true; includeExternal value is irrelevant — all nodes and edges pass through regardless",
          "outcome": "Every node survives the filter and every edge is retained, producing output identical to the input regardless of the includeExternal setting.",
          "is_property": false
        },
        {
