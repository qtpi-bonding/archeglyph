    {
      "node_id": "packages/importer-archegraph/src/from_archegraph.ts/ImportOptions#includeExternal.",
      "symbol_name": "includeExternal",
      "file_path": "packages/importer-archegraph/src/from_archegraph.ts",
      "cases": [
        {
          "name": "not-set-options-omitted",
          "condition": "options argument is omitted entirely; includeExternal is never referenced — defaults to false, external nodes are excluded",
          "outcome": "Returns a Diagram with all external nodes excluded and their incident edges dropped, because omitting options causes includeExternal to default to false.",
          "is_property": false
        },
        {
          "name": "not-set-empty-options",
          "condition": "options is passed as {} with no includeExternal key — field is absent, defaults to false",
          "outcome": "Returns a Diagram with all external nodes excluded and their incident edges dropped, because an absent includeExternal field defaults to false.",
          "is_property": false
        },
        {
          "name": "explicit-false",
          "condition": "includeExternal is explicitly set to false — external nodes excluded, edges touching any excluded node are dropped",
          "outcome": "Returns a Diagram containing only non-external nodes, with any edge whose source or target was excluded also dropped.",
          "is_property": false
        },
        {
          "name": "explicit-true",
          "condition": "includeExternal is set to true — all nodes retained regardless of is_external flag, no edges dropped due to external filtering",
          "outcome": "Returns a Diagram containing all nodes and all edges with no external-filtering applied, because includeExternal=true bypasses the filter entirely.",
          "is_property": false
        },
        {
          "name": "false-no-external-nodes",
          "condition": "includeExternal is false but the input graph contains zero nodes with is_external=true — filter matches nothing, output is unchanged",
          "outcome": "Returns a Diagram identical to a full conversion of the input, because the external filter matches no nodes and removes nothing.",
          "is_property": false
        },
        {
          "name": "false-all-nodes-external",
          "condition": "includeExternal is false and every ViewNode has is_external=true — all nodes and all edges are dropped, output graph is empty",
          "outcome": "Returns a Diagram whose Graph has empty nodes and edges maps, because every node is excluded and every edge loses at least one endpoint.",
          "is_property": false
        },
        {
          "name": "false-edge-source-external",
          "condition": "includeExternal is false and an edge's source node has is_external=true; target is internal — edge is dropped even though target is retained",
          "outcome": "Returns a Diagram in which the edge is absent even though its target node is present, because exclusion of the source node causes the edge to be dropped.",
          "is_property": false
        },
        {
          "name": "false-edge-target-external",
          "condition": "includeExternal is false and an edge's target node has is_external=true; source is internal — edge is dropped even though source is retained",
          "outcome": "Returns a Diagram in which the edge is absent even though its source node is present, because exclusion of the target node causes the edge to be dropped.",
          "is_property": false
        },
        {
          "name": "false-edge-both-endpoints-external",
          "condition": "includeExternal is false and both source and target of an edge have is_external=true — both nodes and the edge are all dropped",
          "outcome": "Returns a Diagram in which neither node nor the edge between them appears, because both endpoints are excluded and the edge is therefore also dropped.",
          "is_property": false
        },
        {
          "name": "false-internal-only-edge-unaffected",
          "condition": "includeExternal is false but an edge's source and target are both internal (is_external=false) — edge is retained regardless of the flag",
          "outcome": "Returns a Diagram in which the edge is mapped and present, because both its source and target passed the external filter.",
          "is_property": false
        },
        {
          "name": "false-mixed-external-internal",
          "condition": "Graph has a mix of external and internal nodes with edges between them and includeExternal is false — only internal nodes survive and only internal-to-internal edges survive",
          "outcome": "Returns a Diagram containing only the internal nodes and only the edges whose source and target are both internal, with all cross-boundary edges dropped.",
          "is_property": true
        },
        {
          "name": "true-all-nodes-external",
          "condition": "includeExternal is true and every ViewNode has is_external=true — all nodes and edges are retained in the output",
          "outcome": "Returns a Diagram containing every node and every edge from the input, because includeExternal=true suppresses all external filtering.",
          "is_property": false
        }
      ]
    },
    {
      "node_id": "packages/importer-archegraph/src/from_archegraph.ts/fromArchegraph().",
      "symbol_name": "fromArchegraph",
      "file_path": "packages/importer-archegraph/src/from_archegraph.ts",
      "cases": [
        {
          "name": "happy-path-full-view",
          "condition": "Archeview with non-empty nodes and edges, all fields populated (id, display_name, kind_label, non-empty scip_symbol, tags), project_name set in metadata, includeExternal defaults to false and some nodes are external",
          "outcome": "Maps all non-external nodes and their connecting edges to the Diagram, populating all Node and Edge fields from the corresponding ViewNode/ViewEdge fields, using project_name as Diagram.id.",
          "is_property": false
        },
        {
          "name": "happy-path-no-external-filter",
          "condition": "Archeview where includeExternal is explicitly true and some ViewNodes are external — all nodes and their edges pass through without filtering",
          "outcome": "Passes all nodes (including external ones) and all edges through to the Diagram without any filtering.",
          "is_property": false
        },
        {
          "name": "happy-path-no-nodes-no-edges",
          "condition": "Archeview with empty nodes and edges arrays and a valid project_name — produces a Diagram with empty graph",
          "outcome": "Returns a Diagram with the correct id and metadata but with empty Graph.nodes and Graph.edges maps.",
          "is_property": false
        },
        {
          "name": "project-name-present",
          "condition": "view.metadata.project_name is a non-empty string — used as Diagram.id",
          "outcome": "Sets Diagram.id to the value of view.metadata.project_name.",
          "is_property": false
        },
        {
          "name": "project-name-absent-or-empty",
          "condition": "view.metadata.project_name is absent, null, or empty string — Diagram.id falls back to 'imported'",
          "outcome": "Sets Diagram.id to the string 'imported'.",
          "is_property": false
        },
        {
          "name": "node-scip-symbol-non-empty",
          "condition": "ViewNode.scip_symbol is a non-empty string — mapped to Node.tags['archegraph.symbol']",
          "outcome": "Includes an 'archegraph.symbol' entry in Node.tags whose value is the scip_symbol string.",
          "is_property": false
        },
        {
          "name": "node-scip-symbol-empty",
          "condition": "ViewNode.scip_symbol is an empty string — Node.tags['archegraph.symbol'] is omitted",
          "outcome": "Omits the 'archegraph.symbol' key from Node.tags entirely.",
          "is_property": false
        },
        {
          "name": "node-tags-non-empty",
          "condition": "ViewNode.tags contains one or more key-value pairs — all are merged into Node.tags alongside the archegraph.kind (and optionally archegraph.symbol) entries",
          "outcome": "Produces a Node.tags object containing both the synthetic 'archegraph.*' entries and all key-value pairs from ViewNode.tags.",
          "is_property": true
        },
        {
          "name": "node-tags-empty",
          "condition": "ViewNode.tags is empty or absent — Node.tags contains only the archegraph.* synthetic entries",
          "outcome": "Produces a Node.tags object containing only the synthetic 'archegraph.kind' entry (and 'archegraph.symbol' if applicable).",
          "is_property": false
        },
        {
          "name": "node-tags-collision-with-synthetic",
          "condition": "ViewNode.tags contains a key that collides with 'archegraph.kind' or 'archegraph.symbol' — merge order determines which value wins",
          "outcome": "The synthetic 'archegraph.kind'/'archegraph.symbol' values win if they are written last; otherwise ViewNode.tags values win — whichever the merge order dictates.",
          "is_property": false
        },
        {
          "name": "edge-tags-non-empty",
          "condition": "ViewEdge.tags contains one or more key-value pairs — all are copied into Edge.tags",
