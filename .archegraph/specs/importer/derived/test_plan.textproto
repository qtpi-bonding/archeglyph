          "is_property": true
        },
        {
          "name": "edge-tags-empty",
          "condition": "ViewEdge.tags is empty or absent — Edge.tags is empty",
          "outcome": "Sets Edge.tags to an empty object.",
          "is_property": false
        },
        {
          "name": "include-external-false-filters-external-nodes",
          "condition": "includeExternal is false (default) and some ViewNodes are marked external — those nodes and any edges referencing them as source or target are excluded",
          "outcome": "Excludes external ViewNodes from Graph.nodes and also drops any edge whose source or target id matches an excluded node.",
          "is_property": false
        },
        {
          "name": "edge-source-or-target-filtered-out",
          "condition": "An edge whose source or target references a node that was removed by the external filter — edge must also be dropped",
          "outcome": "Drops the edge from Graph.edges because at least one endpoint was removed by the external filter.",
          "is_property": false
        },
        {
          "name": "all-nodes-external-include-external-false",
          "condition": "Every ViewNode is external and includeExternal is false — resulting Diagram has no nodes and no edges",
          "outcome": "Returns a Diagram whose Graph.nodes and Graph.edges maps are both empty.",
          "is_property": false
        },
        {
          "name": "all-nodes-external-include-external-true",
          "condition": "Every ViewNode is external and includeExternal is true — all nodes and edges are preserved",
          "outcome": "Returns a Diagram containing all nodes and all edges with no filtering applied.",
          "is_property": false
        },
        {
          "name": "node-display-name-non-empty",
          "condition": "ViewNode.display_name is a non-empty string — mapped to Node.label as [{ locale: 'en', source: display_name }]",
          "outcome": "Sets Node.label to the array [{ locale: 'en', source: display_name }].",
          "is_property": true
        },
        {
          "name": "node-display-name-empty",
          "condition": "ViewNode.display_name is an empty string — label array is [{ locale: 'en', source: '' }] or omitted depending on implementation",
          "outcome": "Sets Node.label to [{ locale: 'en', source: '' }] or omits the label field, depending on implementation choice for empty strings.",
          "is_property": false
        },
        {
          "name": "edge-kind-label-non-empty",
          "condition": "ViewEdge.kind_label is a non-empty string — mapped to Edge.label as [{ locale: 'en', source: kind_label }]",
          "outcome": "Sets Edge.label to the array [{ locale: 'en', source: kind_label }].",
          "is_property": true
        },
        {
          "name": "edge-kind-label-empty",
          "condition": "ViewEdge.kind_label is an empty string — Edge.label is [{ locale: 'en', source: '' }] or omitted",
          "outcome": "Sets Edge.label to [{ locale: 'en', source: '' }] or omits the label field, depending on implementation choice for empty strings.",
          "is_property": false
        },
        {
          "name": "duplicate-node-ids",
          "condition": "Two ViewNodes share the same id — last-write-wins in the Graph.nodes map, or the function throws/deduplicates",
          "outcome": "The later-encountered node silently overwrites the earlier one in Graph.nodes (last-write-wins), producing a map with one entry for that id.",
