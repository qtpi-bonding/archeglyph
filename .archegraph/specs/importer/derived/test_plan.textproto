        },
        {
          "name": "include-external-true",
          "condition": "includeExternal is true; all ViewNodes regardless of is_external flag pass through, and all edges are retained",
          "outcome": "Every ViewNode passes through regardless of its is_external flag, and every edge is retained unchanged.",
          "is_property": false
        },
        {
          "name": "all-nodes-external",
