# Wave 5. The three commands that operate on pinning, wired to the registry
# built in wave 4. The builders they call already exist in
# state/edits/layout_command.

file: "packages/editor/src/gestures/commands.ts"
doc: "The registry of named editor actions, shared by the keyboard, palette and menus."

constants: [
  { name: "COMMANDS"
    change_type: MODIFIED
    doc:
      "Three entries added; everything already there is unchanged.\n"
      "\n"
      "  pin-all — writes every laid-out position into the stylesheet, so the\n"
      "    diagram is exactly what is on screen and ELK stops running.\n"
      "  unpin-all — removes EVERY explicit position in the stylesheet,\n"
      "    whatever wrote it: pin-all, a drag, a nudge, or a hand-edited\n"
      "    file. Not only the ones pin-all put there. The whole diagram goes\n"
      "    back to ELK.\n"
      "  auto-layout — produces the identical StyleEdit that unpin-all\n"
      "    produces, and nothing further; the relayout is not a second step\n"
      "    but the consequence of clearing the positions, since a stylesheet\n"
      "    with no positions sends the next scene through ELK. It exists as a\n"
      "    separate command because 'lay this out again' and 'stop pinning'\n"
      "    are different intentions, even though the edit is the same one.\n"
      "\n"
      "pin-all needs the Scene's LaidOutDiagram, since pinning means writing\n"
      "down where things currently are. It is a no-op with no geometry rather\n"
      "than an error -- a command firing before the first layout has resolved\n"
      "is a timing accident, not a mistake by the user."
    type: { named: { symbol: "Array", args: [{ named: { symbol: "Command" } }] } }
    # Command is absent: it is the element type of the declared
    # Array<Command>, which is a structural TypeRef rather than anything the
    # array's value expression references.
    uses: ["CommandContext", "clearSelection"]
    # Grandfathered post-build: the pin commands delegate to file-local runners
    # rather than inlining the builder calls in the array literal, so those
    # edges belong to the runners. Same shape as the wave 4 commands.
  }
]
