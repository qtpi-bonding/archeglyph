      "file_path": "packages/core/src/layout/layout_adapter/impl.ts",
      "cases": [
        {
          "name": "element-with-explicit-position",
          "condition": "An element whose style entry carries an explicit x/y position is sent to ELK with that position set as node x/y and with 'org.eclipse.elk.position' set on the node",
          "outcome": "runLayout sets the ELK node's x and y to the style entry's explicit position and sets the 'org.eclipse.elk.position' layout option on that node.",
          "is_property": false
        },
        {
          "name": "parent-gets-fixed-option-with-mixed-children",
          "condition": "A parent whose children include at least one explicitly-positioned (immovable) child and at least one unpositioned child has 'org.eclipse.elk.fixed' added to its own layoutOptions",
          "outcome": "runLayout adds 'org.eclipse.elk.fixed' to the parent's layoutOptions when at least one child is explicitly positioned and at least one is not.",
          "is_property": false
        },
        {
          "name": "parent-without-any-positioned-children",
          "condition": "A parent all of whose children are unpositioned does not get 'org.eclipse.elk.fixed' added to its layoutOptions",
          "outcome": "runLayout does not add 'org.eclipse.elk.fixed' to the parent's layoutOptions when none of its children are explicitly positioned.",
          "is_property": false
        },
        {
          "name": "parent-with-all-children-positioned",
          "condition": "A parent all of whose children carry explicit positions still gets (or does not spuriously omit) 'org.eclipse.elk.fixed' as appropriate for an all-fixed set",
          "outcome": "runLayout still correctly sets (or omits, as appropriate) 'org.eclipse.elk.fixed' on a parent whose children are all explicitly positioned, consistent with the fixed-set semantics.",
          "is_property": false
        },
        {
          "name": "element-with-zero-position",
