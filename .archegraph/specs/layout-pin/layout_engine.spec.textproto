# Wave 5. The half of pin-on-touch that makes a pinned diagram STABLE.
#
# Pinning itself already works: writing NodeLayout.position is what pins an
# element, and every move edit writes one (D1/D8, state/edits/move). What is
# missing is the consequence — ELK still runs on every scene rebuild and still
# gets to have an opinion about where everything goes.
#
# The failure that matters is not "layout is slow". It is that a user arranges
# a diagram, adds one node, and everything they positioned rearranges itself.
# That is the single most destructive thing an auto-layout editor can do, and
# it is why D1 makes ELK a seed rather than an authority.

file: "packages/core/src/layout/layout_engine/impl.ts"
doc: "Layout orchestrator — runs elkjs when something still needs placing, and otherwise uses the positions already written down."

structs: [
  { name: "LayoutEngineImpl"
    change_type: MODIFIED
    methods: [
      { name: "layout"
        change_type: MODIFIED
        is_async: true
        doc:
          "Two paths now.\n"
          "\n"
          "FULLY PINNED — every node and group in the diagram has an explicit\n"
          "position in the stylesheet. ELK is not called at all. Positions come\n"
          "straight from the style entries and edges are routed by\n"
          "edge_router. Nothing can drift, because nothing is being computed.\n"
          "\n"
          "OTHERWISE — some elements are pinned and some are not. ELK cannot\n"
          "be asked to respect the pinned ones: elk.layered ignores fixed\n"
          "positions outright (measured, including interactive mode and all\n"
          "four interactive phase strategies) and elk.fixed honours them but\n"
          "places nothing. So seedNewcomers assigns positions for the unpinned\n"
          "elements, near whatever they connect to, and the pinned ones are\n"
          "used exactly as written. ELK is not consulted for placement in this\n"
          "path at all.\n"
          "\n"
          "WHAT THIS ACTUALLY FIXES, which is not what it first appears.\n"
          "\n"
          "Pinned elements ALREADY land where the stylesheet declares: the\n"
          "override loops below run after ELK and overwrite any element that\n"
          "carries an explicit position. Verified by test before this pillar\n"
          "was built -- pin two nodes, add a third, and the two do not move.\n"
          "That was already green.\n"
          "\n"
          "The defect is that ELK is never TOLD about those positions. It is\n"
          "overruled afterwards rather than informed beforehand, so it is free\n"
          "to place a newcomer exactly where a pinned element is about to be\n"
          "put back -- and the override then drops one on top of the other.\n"
          "\n"
          "So the testable claim is about OVERLAP, not about movement: after\n"
          "adding an unpositioned element to a diagram of pinned ones, the new\n"
          "element must not intersect any of them. See\n"
          "packages/core/src/layout/pin.test.ts, which fails today.\n"
          "\n"
          "Skipping ELK when fully pinned is a separate benefit -- determinism\n"
          "and speed -- and is not what makes the layout correct.\n"
          "\n"
          "Annotations are excluded from the fully-pinned test. They are always\n"
          "explicitly positioned and never laid out, so they say nothing about\n"
          "whether ELK is needed."
        inputs: [
          { name: "request", type: { named: { symbol: "LayoutRequest" } } }
        ]
        output: { named: { symbol: "archeglyph.util.Result", args: [
          { named: { symbol: "LaidOutDiagram" } },
          { named: { symbol: "LayoutError" } }
        ]}}
        uses: ["absolutizePositions", "isFullyPinned", "layoutFromPins", "seedNewcomers"]
      },
      { name: "isFullyPinned"
        doc: "True when every node and group carries an explicit position. Private."
        inputs: [
          { name: "diagram", type: { named: { symbol: "ResolvedDiagram" } } }
        ]
        output: { primitive: BOOLEAN }
      },
      { name: "layoutFromPins"
        doc:
          "Builds a LaidOutDiagram entirely from written positions, with sizes\n"
          "from measureLabel where a style entry gives none, and edge routes\n"
          "from edge_router. Private; only reached when isFullyPinned holds,\n"
          "so every lookup is total and a missing position is a programming\n"
          "error rather than a case to paper over.\n"
          "\n"
          "Group sizes still have to be derived from their children, because a\n"
          "group's extent is a consequence of what is inside it even when its\n"
          "origin is pinned."
        inputs: [
          { name: "diagram", type: { named: { symbol: "ResolvedDiagram" } } }
        ]
        output: { named: { symbol: "LaidOutDiagram" } }
        uses: ["measureLabel", "routeStraight", "routeOrthogonal"]
      }
    ]
  }
]
