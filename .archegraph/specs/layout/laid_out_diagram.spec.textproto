# The complete output of the layout stage. Everything the renderer needs:
# topology, resolved glyphs, and positions for every element.
# No further lookups into the style or theme files are required after this point.

file: "packages/core/src/layout/laid_out_diagram/impl.ts"
doc: "Fully positioned diagram. Complete input for the renderer — no further style lookups needed."

