# Generic boundary interface to an external auto-layout algorithm.
# Currently implemented by ElkAdapterImpl using elkjs, but the interface
# is algorithm-agnostic — swapping to dagre or a custom layouter requires
# only a new implementation, not an interface change.
#
# This is a RAW layout — position overrides from the style file are NOT
# applied here. ElkAdapterImpl produces positions purely from the algorithm's
# output. LayoutEngineImpl applies overrides on top of this result.
#
# MODIFIED (host-injected ELK, wave 1 of docs/implementation-order.md):
# ElkAdapterImpl's constructor now takes `elk: ELK` (the type from the
# `elkjs` package's default export) as a required param, stored as
# `private readonly elk`. Remove the module-level `const elk = new ELK(...)`
# singleton AND the `import { createRequire } from 'node:module'` /
# `import ELK from 'elkjs'` construction logic entirely — this file must not
# decide which ELK execution strategy (Node worker vs. browser-bundled) to
# use; that choice is the caller's, via the sibling elk_host_node /
# elk_host_browser factories. Use `this.elk.layout(...)` wherever the old
# module-level `elk` was used. `import ELK from 'elkjs'` stays as a
# type-only-ish import (needed for the `elk: ELK` field type).
#
# Also replace every `any`-typed local (elkGraph, elkNode, elk edge/section
# objects) with elkjs's own exported types: `ElkNode`, `ElkExtendedEdge`,
# `ElkEdgeSection` (from 'elkjs/lib/elk-api', or import from the main
# 'elkjs' module if it re-exports them — check elkjs's own .d.ts). Keep
# type assertions only where ElkShape's optional x/y/width/height genuinely
# need a fallback (e.g. `elkNode.x ?? 0`), same as today.
#
# MODIFIED again (wave 2, "layout Δ: annotation size/content"): when
# building each LaidOutAnnotation, also set `content: ann.content`
# (ResolvedAnnotation now carries this — see the annotation_content
# pillar, same session) and `size`: `ann.layout?.size` if the user set an
# explicit AnnotationLayout.size hint, else
# `measureLabel(firstLocalizationText(ann.content), theme-independent — no
# font family needed here, pass any string e.g. 'mono', ann.typography.size
# ?? DEFAULT sizes.font_normal)` from
# `@archeglyph/core/text/font_metrics` — mirrors the existing
# `node.layout?.size?.x ?? DEFAULT_WIDTH` explicit-override-else-auto
# pattern. `firstLocalizationText` here just means: take
# `ann.content[0]?.source ?? ''` (Localization's text field is named
# `source` per content.proto) — no real locale-selection logic belongs at
# this layer, that's a renderer/UI concern for a later wave.
#
# Implementation notes for ElkAdapterImpl (unchanged from before):
#
# Building the elkjs input:
# - Root ELKNode: id="root", layoutOptions: { "org.eclipse.elk.algorithm":
#   "org.eclipse.elk.layered" }
# - Nodes: each ResolvedNode → ELK child with id=node.id, width and height
#   from node.layout?.size (if set), otherwise use a default size (e.g. 120x40).
# - Groups with isSuperNode=false: ELK compound node (has its own children
#   array). Set node.id as ELK parent for each child node/group.
# - Groups with isSuperNode=true: ELK leaf node (no children array) — the
#   VisibilityFilter already removed its children from the diagram.
# - Edges: each ResolvedEdge → ELK edge with sources=[edge.source],
#   targets=[edge.target].
# - Annotations: SKIP — never go through elkjs (always explicitly positioned).
#
# Converting elkjs output to LaidOutDiagram:
# - Walk the ELK result recursively (ELK returns a nested tree matching the
#   input hierarchy).
# - For each ELK node: extract x, y (position) and width, height (size).
#   ELK positions are relative to the node's parent container — this matches
#   LaidOutNode.position semantics.
# - For each ELK edge: extract sections array (startPoint, bendPoints,
#   endPoint per section) → EdgeSection[].
# - Annotations: copy directly from ResolvedDiagram.annotations, extracting
#   position from annotation.layout?.position ?? { x: 0, y: 0 }, plus the
#   new size/content construction described above.
# - Build LaidOutNode/LaidOutEdge/LaidOutGroup/LaidOutAnnotation/LaidOutDiagram
#   with all fields supplied at construction time (see archebuild.yaml rule).

file: "packages/core/src/layout/layout_adapter/impl.ts"
doc: "Auto-layout boundary — converts ResolvedDiagram to algorithm input, runs layout, converts result back. ELK instance is host-injected (see elk_host_node / elk_host_browser); this file has no node:module or environment-specific import."

structs: [
  { name: "ElkAdapterImpl"
    change_type: MODIFIED
    implements: [{ named: { symbol: "LayoutAdapter" } }]
    fields: [
      { name: "elk"
        doc: "Host-injected ELK instance (from elk_host_node or elk_host_browser). Set via a real constructor param — `constructor(private readonly elk: ELK) {}` — NOT the Object.assign data-class convention; this is a service class with a real dependency-injected constructor."
        type: { unsupported: { reason: RAW_EXPRESSION, source_excerpt: "ELK" } }
      }
    ]
    methods: [
      { name: "runLayout"
        is_async: true
        inputs: [
          { name: "diagram",
            type: { named: { symbol: "ResolvedDiagram" } } }
        ]
        output: { named: { symbol: "archeglyph.util.Result", args: [
          { named: { symbol: "LaidOutDiagram" } },
          { named: { symbol: "LayoutError" } }
        ]}}
        uses: [
          "LaidOutNode", "LaidOutEdge", "LaidOutGroup",
          "LaidOutAnnotation", "LaidOutDiagram", "EdgeSection",
          "measureLabel"
        ]
      }
    ]
  }
]

interfaces: [
  { name: "LayoutAdapter"
    methods: [
      { name: "runLayout"
        is_async: true
        inputs: [
          { name: "diagram",
            type: { named: { symbol: "ResolvedDiagram" } } }
        ]
        output: { named: { symbol: "archeglyph.util.Result", args: [
          { named: { symbol: "LaidOutDiagram" } },
          { named: { symbol: "LayoutError" } }
        ]}}
      }
    ]
  }
]
