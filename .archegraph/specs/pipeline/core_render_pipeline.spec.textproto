file: "packages/core/src/pipeline/render_pipeline.ts"
doc:
  "Shared render pipeline: resolvePipeline → layout → renderer → SVG string.\n"
  "Extracted so the editor Canvas and PendingOverlay call the same code path\n"
  "as renderOp, eliminating drift. Async — layout wraps elkjs."

methods: [
  { name: "renderPipeline"
    doc:
      "Calls resolvePipeline, then layout, then render. Returns Err with stage\n"
      "set to 'layout' or 'render' for failures after the resolve phase\n"
      "(resolve failures propagate their stage names from resolvePipeline)."
    is_async: true
    inputs: [
      { name: "diagram",    type: { named: { symbol: "archeglyph.content.v1.Diagram" } } },
      { name: "stylesheet", type: { named: { symbol: "archeglyph.style.v1.Stylesheet" } }, is_optional: true },
      { name: "theme",      type: { named: { symbol: "archeglyph.theme.v1.Theme" } } }
    ]
    output: { named: { symbol: "archeglyph.util.Result", args: [
      { primitive: CHARACTER },
      { named: { symbol: "PipelineError" } }
    ]}}
    uses: [
      "resolvePipeline",
      "LayoutEngineImpl", "LayoutRequest",
      "SvgRendererImpl"
    ]
  }
]
