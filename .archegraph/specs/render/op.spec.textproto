file: "packages/ops/src/render/op.ts"
doc:
  "renderOp: the first end-to-end Operation in archeglyph. Stitches "
  "loaders → resolver (visibility filter → style cascade → token resolver) "
  "→ layout → renderer into a single CLI/MCP-callable op. Plus two helpers "
  "(deriveOutPath, defaultTheme).\n"
  "\n"
  "Files in this pillar (one .ts per .spec.textproto):\n"
  "  packages/ops/src/render/op.ts               ← THIS FILE (renderOp, deriveOutPath, defaultTheme)\n"
  "  packages/ops/src/render/render_params.ts    ← RenderParams + zod schema\n"
  "  packages/ops/src/render/render_output.ts    ← RenderOutput\n"
  "  packages/ops/src/render/render_op_error.ts  ← RenderOpError extends Error\n"
  "\n"
  "Plus a MODIFIED packages/ops/src/registry.ts — REGISTRY adds renderOp."

methods: [
  { name: "renderOp"
    doc:
      "The Operation literal — first end-to-end op in archeglyph. Spec models "
      "it as a zero-input method returning `unsupported` so the contract has "
      "a node; emit as `export const`, NOT a function (same pattern as "
      "REGISTRY in ops_framework/registry.ts).\n"
      "\n"
      "Emit exactly:\n"
      "\n"
      "  // SPDX-License-Identifier: AGPL-3.0-or-later\n"
      "\n"
      "  import { promises as fs } from 'node:fs';\n"
      "  import * as path from 'node:path';\n"
      "  import { create } from '@bufbuild/protobuf';\n"
      "  import {\n"
      "    loadDiagram,\n"
      "    loadStylesheet,\n"
      "    loadTheme,\n"
      "  } from '@archeglyph/core/loaders';\n"
      "  import { VisibilityFilterImpl } from '@archeglyph/core/resolver/visibility_filter';\n"
      "  import { StyleCascadeImpl } from '@archeglyph/core/resolver/style_cascade';\n"
      "  import { TokenResolverImpl } from '@archeglyph/core/resolver/token_resolver';\n"
      "  import { LayoutEngineImpl } from '@archeglyph/core/layout/layout_engine';\n"
      "  import { SvgRendererImpl } from '@archeglyph/core/renderer/svg_renderer';\n"
      "  import { FilterRequest } from '@archeglyph/core/resolver/filter_request';\n"
      "  import { CascadeRequest } from '@archeglyph/core/resolver/cascade_request';\n"
      "  import { ResolveTokensRequest } from '@archeglyph/core/resolver/resolve_tokens_request';\n"
      "  import { LayoutRequest } from '@archeglyph/core/layout/layout_request';\n"
      "  import { ThemeSchema, type Theme } from '@archeglyph/proto/gen/theme_pb';\n"
      "  import { type Stylesheet } from '@archeglyph/proto/gen/style_pb';\n"
      "  import type { Operation, OpContext } from '../op';\n"
      "  import { RenderParams, renderParamsSchema } from './render_params';\n"
      "  import { RenderOutput } from './render_output';\n"
      "  import { RenderOpError } from './render_op_error';\n"
      "\n"
      "  export const renderOp: Operation<RenderParams, RenderOutput> = {\n"
      "    name: 'render',\n"
      "    description: 'Render a Diagram JSON file to an SVG.',\n"
      "    params: renderParamsSchema,\n"
      "    format: (output) =>\n"
      "      `wrote ${output.bytesWritten} bytes to ${output.outPath}`,\n"
      "    execute: async (params, ctx) => {\n"
      "      // 1. Load diagram (required).\n"
      "      const diagramText = await fs.readFile(\n"
      "        path.resolve(ctx.projectRoot, params.diagram), 'utf8');\n"
      "      const diagramR = await loadDiagram(diagramText);\n"
      "      if (!diagramR.ok) throw new RenderOpError('load', diagramR.error);\n"
      "      const diagram = diagramR.value;\n"
      "\n"
      "      // 2. Load stylesheet (optional).\n"
      "      let stylesheet: Stylesheet | undefined;\n"
      "      if (params.style !== undefined) {\n"
      "        const text = await fs.readFile(\n"
      "          path.resolve(ctx.projectRoot, params.style), 'utf8');\n"
      "        const r = await loadStylesheet(text);\n"
      "        if (!r.ok) throw new RenderOpError('load', r.error);\n"
      "        stylesheet = r.value;\n"
      "      }\n"
      "\n"
      "      // 3. Load theme (optional, default to built-in placeholder).\n"
      "      let theme: Theme;\n"
      "      if (params.theme !== undefined) {\n"
      "        const text = await fs.readFile(\n"
      "          path.resolve(ctx.projectRoot, params.theme), 'utf8');\n"
      "        const r = await loadTheme(text);\n"
      "        if (!r.ok) throw new RenderOpError('load', r.error);\n"
      "        theme = r.value;\n"
      "      } else {\n"
      "        theme = defaultTheme();\n"
      "        ctx.logger.info('no --theme provided; using built-in placeholder');\n"
      "      }\n"
      "\n"
      "      // 4. Visibility filter.\n"
      "      const filterReq = Object.assign(new FilterRequest(), { diagram, stylesheet });\n"
      "      const filteredR = new VisibilityFilterImpl().filter(filterReq);\n"
      "      if (!filteredR.ok) throw new RenderOpError('resolve', filteredR.error);\n"
      "\n"
      "      // 5. Style cascade.\n"
      "      const cascadeReq = Object.assign(new CascadeRequest(), {\n"
      "        filtered: filteredR.value, stylesheet, theme });\n"
      "      const cascadedR = new StyleCascadeImpl().cascade(cascadeReq);\n"
      "      if (!cascadedR.ok) throw new RenderOpError('resolve', cascadedR.error);\n"
      "\n"
      "      // 6. Token resolver.\n"
      "      const tokensReq = Object.assign(new ResolveTokensRequest(), {\n"
      "        resolved: cascadedR.value, tokens: theme.tokens });\n"
      "      const resolvedR = new TokenResolverImpl().resolveTokens(tokensReq);\n"
      "      if (!resolvedR.ok) throw new RenderOpError('resolve', resolvedR.error);\n"
      "\n"
      "      // 7. Layout.\n"
      "      const layoutReq = Object.assign(new LayoutRequest(), { diagram: resolvedR.value });\n"
      "      const laidOutR = await new LayoutEngineImpl().layout(layoutReq);\n"
      "      if (!laidOutR.ok) throw new RenderOpError('layout', laidOutR.error);\n"
      "\n"
      "      // 8. Render.\n"
      "      const svgR = new SvgRendererImpl().render(laidOutR.value);\n"
      "      if (!svgR.ok) throw new RenderOpError('render', svgR.error);\n"
      "      const svg = svgR.value;\n"
      "\n"
      "      // 9. Resolve outPath + write.\n"
      "      const outPath = path.resolve(\n"
      "        ctx.projectRoot,\n"
      "        params.out ?? deriveOutPath(params.diagram));\n"
      "      await fs.writeFile(outPath, svg, 'utf8');\n"
      "      const bytesWritten = Buffer.byteLength(svg, 'utf8');\n"
      "\n"
      "      return { svg, outPath, bytesWritten };\n"
      "    },\n"
      "  };\n"
      "\n"
      "Why each stage constructs its impl class with `new` directly: the four "
      "pipeline stages are pure-logic singletons with no DI surface; injecting "
      "them here would be ceremony with no payoff. If a future test needs to "
      "swap, say, the layout engine for a stub, the refactor lives in this op.\n"
      "\n"
      "Why `Object.assign(new Xxx(), { … })` for request types: matches the "
      "project rule from archebuild.yaml's prompt template (\"When constructing "
      "data objects, initialize all fields at construction\"). These request "
      "classes have definite-assignment fields (`diagram!: …`), so direct "
      "construction doesn't satisfy their invariants.\n"
      "\n"
      "Pipeline ORDER matters and is non-obvious. The correct sequence is:\n"
      "  visibility filter → style cascade → token resolver → layout → render\n"
      "Not the other natural-sounding orderings. See the four pillar specs "
      "under .archegraph/specs/{resolver,layout,renderer}/ for why."
    inputs: []
    output: { unsupported: { reason: UNION_AT_TYPE_POSITION } }
    uses: [
      "Operation",
      "OpContext",
      "RenderParams",
      "RenderOutput",
      "RenderOpError",
      "renderParamsSchema",
      "loadDiagram",
      "loadStylesheet",
      "loadTheme",
      "VisibilityFilterImpl",
      "StyleCascadeImpl",
      "TokenResolverImpl",
      "LayoutEngineImpl",
      "SvgRendererImpl",
      "FilterRequest",
      "CascadeRequest",
      "ResolveTokensRequest",
      "LayoutRequest",
      "deriveOutPath",
      "defaultTheme"
    ]
  },
  { name: "deriveOutPath"
    doc:
      "Pure helper. Replaces a file path's extension with `.svg`.\n"
      "\n"
      "Signature:\n"
      "  export function deriveOutPath(diagramPath: string): string\n"
      "\n"
      "Body:\n"
      "  import * as path from 'node:path';\n"
      "\n"
      "  export function deriveOutPath(diagramPath: string): string {\n"
      "    const ext = path.extname(diagramPath);\n"
      "    return ext.length === 0\n"
      "      ? diagramPath + '.svg'\n"
      "      : diagramPath.slice(0, -ext.length) + '.svg';\n"
      "  }\n"
      "\n"
      "Examples:\n"
      "  \"foo.json\"         → \"foo.svg\"\n"
      "  \"foo.diagram.json\" → \"foo.diagram.svg\"\n"
      "  \"foo\"              → \"foo.svg\""
    inputs: [
      { name: "diagramPath", type: { primitive: CHARACTER } }
    ]
    output: { primitive: CHARACTER }
  },
  { name: "defaultTheme"
    doc:
      "Placeholder theme used when --theme is not provided. Returns a minimal "
      "Theme proto with empty tokens — sufficient for diagrams that don't use "
      "$token refs.\n"
      "\n"
      "Signature:\n"
      "  export function defaultTheme(): Theme\n"
      "\n"
      "Body:\n"
      "  import { create } from '@bufbuild/protobuf';\n"
      "  import { ThemeSchema, type Theme } from '@archeglyph/proto/gen/theme_pb';\n"
      "\n"
      "  export function defaultTheme(): Theme {\n"
      "    return create(ThemeSchema, { name: 'archeglyph-default', tokens: undefined });\n"
      "  }\n"
      "\n"
      "When @archeglyph/themes lands as a separate pillar, swap this body to "
      "import + return the bundled `light` theme. The signature stays stable; "
      "only the body changes."
    inputs: []
    output: { named: { symbol: "archeglyph.theme.v1.Theme" } }
  }
]
