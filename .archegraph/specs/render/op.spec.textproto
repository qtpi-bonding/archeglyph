file: "packages/ops/src/render/op.ts"
doc:
  "renderOp: first end-to-end Operation in archeglyph. Stitches loaders → "
  "resolver (visibility filter → style cascade → token resolver) → layout "
  "→ renderer into a single CLI/MCP-callable op. Plus helper "
  "deriveOutPath in this file. defaultTheme was removed when "
  "@archeglyph/themes shipped — the spec now declares its deletion via "
  "_deltas.textproto.\n"
  "\n"
  "Pillar files (one .spec.textproto per .ts target):\n"
  "  op.ts               ← renderOp (ConstantDecl) + deriveOutPath\n"
  "  render_params.ts    ← RenderParams + renderParamsSchema\n"
  "  render_output.ts    ← RenderOutput\n"
  "  render_op_error.ts  ← RenderOpError extends Error\n"
  "\n"
  "Plus brownfield MODIFIED to packages/ops/src/registry.ts adding renderOp "
  "to the REGISTRY array."

constants: [
  { name: "renderOp"
    doc:
      "Operation literal. Object fields: name='render', description, "
      "params=renderParamsSchema cast, format formats bytesWritten + "
      "outPath, async execute body. Pipeline: load diagram → load "
      "stylesheet (if --style) → resolve theme (loadTheme if --theme else "
      "getBundledTheme('light')) → visibility filter → style cascade → "
      "token resolver → layout → svg renderer → writeFile.\n"
      "\n"
      "Each Err short-circuits via throw RenderOpError(stage, cause); "
      "stages: 'load' / 'resolve' / 'layout' / 'render'."
    type: { named: { symbol: "Operation", args: [
      { named: { symbol: "RenderParams" } },
      { named: { symbol: "RenderOutput" } }
    ]}}
    uses: [
      "Operation",
      "OpContext",
      "RenderParams",
      "RenderOutput",
      "RenderOpError",
      "renderParamsSchema",
      "loadDiagram",
      "loadStylesheet",
      "loadTheme",
      "getBundledTheme",
      "VisibilityFilterImpl",
      "StyleCascadeImpl",
      "TokenResolverImpl",
      "LayoutEngineImpl",
      "SvgRendererImpl",
      "FilterRequest",
      "CascadeRequest",
      "ResolveTokensRequest",
      "LayoutRequest",
      "deriveOutPath"
    ]
  }
]

methods: [
  { name: "deriveOutPath"
    doc:
      "Pure helper. Replace the file path's extension with `.svg`. "
      "If the path has no extension, append `.svg`. Use path.extname / "
      "path.basename from 'node:path' — no regex."
    inputs: [
      { name: "diagramPath", type: { primitive: CHARACTER } }
    ]
    output: { primitive: CHARACTER }
  }
]
