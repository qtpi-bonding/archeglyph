file: "packages/ops/src/registry.ts"
doc: "Central registry of all archeglyph operations. Now includes renderOp."

constants: [
  { name: "REGISTRY"
    change_type: MODIFIED
    doc:
      "Brownfield MODIFIED: add renderOp to the REGISTRY array. ops_framework "
      "shipped REGISTRY empty; this pillar adds the first op. Subsequent op "
      "pillars (validate, init, format, watch, bind) will repeat the same "
      "delta — one new entry per op.\n"
      "\n"
      "Edit in place; preserve everything else in the file. Add `import "
      "{ renderOp } from './render/op';` and put renderOp into the array.\n"
      "\n"
      "renderOp's specific type (`Operation<RenderParams, RenderOutput>`) "
      "isn't assignable to REGISTRY's element type (`Operation<unknown, "
      "unknown>`) because `execute(params: P, ctx)` puts P in contravariant "
      "position. Cast via `renderOp as unknown as Operation<unknown, "
      "unknown>` — minimal-noise erasure; main.ts re-narrows at dispatch."
    type: { unsupported: { reason: UNION_AT_TYPE_POSITION } }
    uses: ["renderOp"]
  }
]
