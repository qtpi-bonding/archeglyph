file: "packages/ops/src/render/render_op_error.ts"
doc: "RenderOpError: boundary Error class thrown from renderOp.execute when any pipeline stage fails."

structs: [
  { name: "RenderOpError"
    doc:
      "Boundary error thrown out of renderOp.execute. Flattens the four "
      "typed-Result stage errors (LoadError, ResolveError, LayoutError, "
      "RenderError) into one throwable so main.ts's catch block (per "
      "ops_framework cli_main step 8) gets a real .message via Error rather "
      "than `String(plain-object)` = \"[object Object]\".\n"
      "\n"
      "Emit as `class RenderOpError extends Error`, NOT a plain interface or "
      "type union — override the contract-skeleton's data-class rendering. "
      "Two fields: `stage` (one of 'load' | 'resolve' | 'layout' | 'render') "
      "and `cause` (the underlying typed error; union of LoadError | "
      "ResolveError | LayoutError | RenderError from the respective "
      "@archeglyph/core/* subpackages).\n"
      "\n"
      "Constructor builds the super message as `render: ${stage}: "
      "${cause.message}` and sets `this.name = 'RenderOpError'` so "
      "instanceof checks and stack traces work right.\n"
      "\n"
      "spec models cause as `unsupported` because TS union-at-type-position "
      "doesn't lift through the textproto schema (Koine cascading-loss); "
      "express the union as a type alias in the emitted file."
    fields: [
      { name: "stage", type: { primitive: CHARACTER } },
      { name: "cause", type: { unsupported: { reason: UNION_AT_TYPE_POSITION } } }
    ]
    typescript: {}
  }
]
