file: "packages/ops/src/render/render_output.ts"
doc: "RenderOutput: typed result returned by renderOp.execute."

structs: [
  { name: "RenderOutput"
    doc:
      "Typed result of the `render` op. Consumed by the CLI surface (format() "
      "prints a one-liner using bytesWritten + outPath) and by the MCP "
      "surface (JSON.stringify'd into the tool response — callers there want "
      "the svg field without reading from disk).\n"
      "\n"
      "Fields: svg (the SVG text), outPath (where it was written; absolute "
      "or cwd-relative), bytesWritten (UTF-8 byte length of the svg — use "
      "Buffer.byteLength, NOT String.length; the byte count is what "
      "fs.writeFile actually wrote)."
    fields: [
      { name: "svg",          type: { primitive: CHARACTER } },
      { name: "outPath",      type: { primitive: CHARACTER } },
      { name: "bytesWritten", type: { primitive: INTEGER } }
    ]
    typescript: {}
  }
]
