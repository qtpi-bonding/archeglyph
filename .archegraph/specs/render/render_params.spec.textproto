file: "packages/ops/src/render/render_params.ts"
doc: "RenderParams interface + renderParamsSchema zod schema for the render op."

structs: [
  { name: "RenderParams"
    doc:
      "Typed input for the `render` op. Travels with the paired "
      "renderParamsSchema (single source of truth for both CLI argv and MCP "
      "tool schema).\n"
      "\n"
      "Fields: diagram (required, positional), style (optional), theme "
      "(optional), out (optional). All strings; the optional three are "
      "filesystem paths. archeglyph's on-disk format is JSON.\n"
      "\n"
      "When out is omitted: default to the diagram path with `.svg` extension "
      "swapped in (see deriveOutPath in op.ts). When theme is omitted: render "
      "uses defaultTheme() from op.ts (placeholder until @archeglyph/themes "
      "pillar ships)."
    fields: [
      { name: "diagram", type: { primitive: CHARACTER } },
      { name: "style",   type: { primitive: CHARACTER }, is_optional: true },
      { name: "theme",   type: { primitive: CHARACTER }, is_optional: true },
      { name: "out",     type: { primitive: CHARACTER }, is_optional: true }
    ]
    typescript: {}
  }
]

methods: [
  { name: "renderParamsSchema"
    doc:
      "Zod schema mirror of RenderParams. Emit as `export const`, not a "
      "function — same modeling workaround as REGISTRY in ops_framework.\n"
      "\n"
      "Type-annotate as `z.ZodType<RenderParams>` (not inference, not "
      "z.ZodSchema) so interface/schema drift is a typecheck failure. "
      "zod_argv reads `op.params.shape` to enumerate CLI flags, so the "
      "schema must be a ZodObject — z.ZodType is the narrowest base that "
      "preserves that.\n"
      "\n"
      "Each field's .describe() string becomes both --help text and the MCP "
      "JSON Schema description — make them useful (one short sentence per "
      "field)."
    inputs: []
    output: { unsupported: { reason: UNION_AT_TYPE_POSITION } }
    uses: ["RenderParams"]
  }
]
