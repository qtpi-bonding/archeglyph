file: "packages/ops/src/render/render_params.ts"
doc: "RenderParams class + renderParamsSchema zod schema for the render op."

structs: [
  { name: "RenderParams"
    doc:
      "Typed input for the `render` op. Travels with the paired "
      "renderParamsSchema (single source of truth for both CLI argv and MCP "
      "tool schema).\n"
      "\n"
      "Fields: diagram (required positional), style/theme/out (optional). "
      "All strings; the optional three are filesystem paths. archeglyph's "
      "on-disk format is JSON."
    fields: [
      { name: "diagram", type: { primitive: CHARACTER } },
      { name: "style",   type: { primitive: CHARACTER }, is_optional: true },
      { name: "theme",   type: { primitive: CHARACTER }, is_optional: true },
      { name: "out",     type: { primitive: CHARACTER }, is_optional: true }
    ]
    typescript: {}
  }
]

constants: [
  { name: "renderParamsSchema"
    doc:
      "Zod schema mirror of RenderParams. `export const`, type-annotated "
      "as `z.ZodType<RenderParams>` so interface/schema drift is a "
      "typecheck failure. zod_argv reads `op.params.shape` to enumerate "
      "CLI flags, so the underlying value must be a ZodObject — "
      "z.ZodType is the narrowest base type that preserves that.\n"
      "\n"
      "Each field's .describe() string becomes --help text and the MCP "
      "JSON Schema description."
    type: { named: { symbol: "z.ZodType", args: [
      { named: { symbol: "RenderParams" } }
    ]}}
    uses: ["RenderParams"]
  }
]
