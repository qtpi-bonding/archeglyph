file: "packages/ops/src/render/render_params.ts"
doc: "RenderParams interface + renderParamsSchema zod schema for the render op."

structs: [
  { name: "RenderParams"
    doc:
      "Typed input shape for the `render` op. Travels with `renderParamsSchema` "
      "(the paired zod schema below) which is the single source of truth for "
      "both CLI argv parsing and MCP tool schema.\n"
      "\n"
      "Emit exactly:\n"
      "  export interface RenderParams {\n"
      "    diagram: string;\n"
      "    style?: string;\n"
      "    theme?: string;\n"
      "    out?: string;\n"
      "  }\n"
      "\n"
      "Field semantics:\n"
      "  - diagram: positional path to a Diagram JSON file (required). "
      "archeglyph's on-disk format is JSON (per proto_utils pillar, commit "
      "2670f88). Loader parses via @archeglyph/proto/util/json.\n"
      "  - style: path to a Stylesheet JSON file (optional). When omitted, no "
      "stylesheet overrides apply; the diagram's intrinsic per-node styles "
      "and the active theme provide the visual.\n"
      "  - theme: path to a Theme JSON file (optional). When omitted, render "
      "uses a built-in default placeholder (defaultTheme() in op.ts) until "
      "the @archeglyph/themes pillar ships.\n"
      "  - out: explicit output SVG path (optional). When omitted, defaults "
      "to the diagram path with `.svg` extension swapped in (see deriveOutPath "
      "in op.ts). `-` is NOT special; we don't pipe SVG."
    fields: [
      { name: "diagram", type: { primitive: CHARACTER } },
      { name: "style",   type: { primitive: CHARACTER }, is_optional: true },
      { name: "theme",   type: { primitive: CHARACTER }, is_optional: true },
      { name: "out",     type: { primitive: CHARACTER }, is_optional: true }
    ]
    typescript: {}
  }
]

methods: [
  { name: "renderParamsSchema"
    doc:
      "Zod schema mirror of RenderParams. Emit as a `const`, NOT a function — "
      "the spec models it as a zero-input method only because there's no "
      "standalone schema-decl shape (same workaround as REGISTRY in "
      "ops_framework/registry.ts before ConstantDecl.uses).\n"
      "\n"
      "Emit exactly:\n"
      "  import { z } from 'zod';\n"
      "  import type { RenderParams } from './render_params';\n"
      "\n"
      "  export const renderParamsSchema: z.ZodType<RenderParams> = z.object({\n"
      "    diagram: z.string().describe('path to the Diagram JSON file'),\n"
      "    style: z.string().optional().describe('path to a Stylesheet JSON file'),\n"
      "    theme: z.string().optional().describe('path to a Theme JSON file'),\n"
      "    out: z.string().optional().describe('output SVG path; defaults to "
      "the diagram path with .svg extension'),\n"
      "  });\n"
      "\n"
      "Use `z.ZodType<RenderParams>` (NOT inference, NOT `z.ZodSchema`) so "
      "interface/schema drift causes a typecheck failure. zod_argv reads "
      "`op.params.shape` to enumerate CLI flags, so the schema must be a "
      "ZodObject — `z.ZodType<RenderParams>` is the narrowest base that "
      "preserves that.\n"
      "\n"
      "Note: this file (render_params.ts) exports BOTH the interface AND the "
      "schema. Single file, two exports — keep them adjacent so the "
      "single-source-of-truth invariant is enforced by proximity."
    inputs: []
    output: { unsupported: { reason: UNION_AT_TYPE_POSITION } }
    uses: ["RenderParams"]
  }
]
