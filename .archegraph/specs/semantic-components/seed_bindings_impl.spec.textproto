# The traversal half of the binding rule. Existing file; the function keeps
# its signature shape and gains the per-element derivation.
#
# Vocabulary is fixed in derive.spec.textproto's header and used identically
# here: "component name" = a style entry's `component` value; "theme name" =
# a key of Stylesheet.themes.

file: "packages/core/src/resolver/seed_bindings/impl.ts"
doc: "Writes each element's component name into the stylesheet as ordinary data."

methods: [
  { name: "seedComponentBindings"
    change_type: MODIFIED
    doc:
      "Decide each element's component name and return a stylesheet carrying\n"
      "them, for all four element types.\n"
      "\n"
      "Returns a NEW Stylesheet. The `stylesheet` argument is not mutated:\n"
      "after the call it holds exactly what it held before, and a caller may\n"
      "keep using it. Callers that want the result persisted must store what\n"
      "is returned.\n"
      "\n"
      "Per element, with d = this element type's default_*_component on the\n"
      "theme and derived = deriveComponent(the element's tags[\"kind\"], the\n"
      "theme's component names for this element type, d):\n"
      "\n"
      "  derived is undefined            -> write nothing for this element\n"
      "  isThemeDefault(current, d) true -> set `component` to derived\n"
      "  otherwise                       -> leave `component` untouched\n"
      "\n"
      "where `current` is the element's existing `component` value, or\n"
      "undefined when the stylesheet holds no entry for that element id.\n"
      "These are two write outcomes and one no-op, not three: an element\n"
      "with no entry and an element whose entry has an unset `component`\n"
      "both go through isThemeDefault, which is true for undefined and for\n"
      "empty. When such an element needs a component name, create the entry\n"
      "for it.\n"
      "\n"
      "The value written is always the bare name deriveComponent returned.\n"
      "This function never writes a qualified name: \"store\", never\n"
      "\"default.store\". Unqualified already means the theme named `default`,\n"
      "which is the only theme seeding acts on.\n"
      "\n"
      "Worked case: a node with tags {kind: \"store\"}, a stylesheet entry\n"
      "whose component is \"glyph\", and a theme whose default_node_component\n"
      "is \"glyph\" and which defines a node component named \"store\", comes\n"
      "out with component \"store\". The same node with an entry of \"queue\"\n"
      "comes out with component \"queue\".\n"
      "\n"
      "Nodes, edges and groups are enumerated from the diagram's graph, and\n"
      "their tags come from there too. Annotations are enumerated from the\n"
      "stylesheet's own annotations map and their tags come from\n"
      "AnnotationEntry.tags; they exist in no diagram.\n"
      "\n"
      "An absent theme returns the `stylesheet` argument unchanged. A diagram\n"
      "with no graph does NOT return early: nodes, edges and groups are\n"
      "skipped because there are none to enumerate, and annotations are\n"
      "still seeded from the stylesheet.\n"
      "\n"
      "Idempotent: seeding a stylesheet twice gives the same result as once.\n"
      "This is load-bearing rather than merely tidy. The editor seeds at load\n"
      "and stores the result, then re-seeds a throwaway copy on every scene\n"
      "rebuild and discards it (packages/editor/src/scene/scene.ts). Those\n"
      "two agree only because the second application changes nothing;\n"
      "without idempotence the canvas would render one component while the\n"
      "inspector and the saved file showed another.\n"
      "\n"
      "This function is what makes a diagram with no style file render, and\n"
      "it does so by writing ORDINARY DATA. It is not a resolve-time\n"
      "fallback and does not add one: theme.proto's promise that the\n"
      "resolver never guesses a component name still holds, and an element\n"
      "whose entry names no component still resolves unstyled if seeding was\n"
      "not run. The entries written here are indistinguishable from ones a\n"
      "user typed — visible in the inspector, editable, saved to the file.\n"
      "\n"
      "deriveComponent and isThemeDefault live in ./derive.ts, which is built\n"
      "separately and will NOT exist on disk while this file is being\n"
      "written. Import both from './derive'; do not redeclare them here.\n"
      "\n"
      "This takes ONE theme, not the theme map the cascade takes, and that is\n"
      "deliberate. Seeding acts only on the theme named `default`: an element\n"
      "whose component name points at another theme reaches the third outcome\n"
      "and is left alone whatever that theme defines. Two costs are accepted:\n"
      "a kind tag cannot derive into a component only a non-default theme\n"
      "defines, and if two theme names are bound to the same theme, a\n"
      "component name written under the other name is not recognised.\n"
      "\n"
      "Two interactions recorded rather than solved. Setting an element to\n"
      "the theme's own default is not expressible: `archeglyph bind\n"
      "--component glyph` where `glyph` IS the default reads as \"nobody\n"
      "chose\" and is overwritten on the next load. Qualifying it does not\n"
      "help, since isThemeDefault splits both sides. And \"nobody chose\" is\n"
      "anchored to the CURRENT theme's default, so swapping to a theme whose\n"
      "default has a different name leaves every existing component name in\n"
      "the third outcome and the rewrite stops firing. All three bundled\n"
      "themes name their default `glyph`, so the second is latent today.\n"
      "\n"
      "Annotations need a note in the emitted source. A node, edge or group\n"
      "keeps its tags in the diagram, which the editor never writes, so those\n"
      "tags change only when the diagram does, which means a reload — load is\n"
      "therefore the only moment their component name needs reconsidering.\n"
      "An annotation keeps its tags in the stylesheet, which the editor does\n"
      "write, so its kind could change mid-session if tag editing were ever\n"
      "added to the inspector. Nothing edits tags today."
    inputs: [
      { name: "diagram", type: { named: { symbol: "archeglyph.content.v1.Diagram" } } },
      { name: "stylesheet", type: { named: { symbol: "archeglyph.style.v1.Stylesheet" } } },
      { name: "theme", type: { named: { symbol: "archeglyph.theme.v1.Theme" } }, is_optional: true }
    ]
    output: { named: { symbol: "archeglyph.style.v1.Stylesheet" } }
    uses: ["deriveComponent", "isThemeDefault"]
  }
]
