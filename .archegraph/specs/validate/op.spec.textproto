file: "packages/ops/src/validate/op.ts"
doc:
  "validateOp — second end-to-end Operation. Mirror renderOp at "
  "packages/ops/src/render/op.ts; same shape, but skip layout + render. "
  "defaultTheme was removed when @archeglyph/themes shipped — the body "
  "now calls getBundledTheme('light') directly.\n"
  "\n"
  "Pillar files: op.ts, validate_params.ts, validate_output.ts, "
  "validate_op_error.ts. Plus brownfield MODIFIED to "
  "packages/ops/src/registry.ts adding validateOp to REGISTRY."

constants: [
  { name: "validateOp"
    doc:
      "Operation literal. Pipeline:\n"
      "  load diagram → Validator → optional load stylesheet/theme → "
      "visibility filter → style cascade → token resolver → assemble output.\n"
      "Each Err → throw ValidateOpError(stage, cause). Track completed "
      "stages in stagesRun so partial-failure diagnostics are useful. "
      "exitCode: o.passed ? 0 : 1.\n"
      "\n"
      "When --theme is omitted: call getBundledTheme('light') from "
      "@archeglyph/themes and log via ctx.logger.info that the default is "
      "in use."
    type: { named: { symbol: "Operation", args: [
      { named: { symbol: "ValidateParams" } },
      { named: { symbol: "ValidateOutput" } }
    ]}}
    uses: [
      "Operation",
      "OpContext",
      "ValidateParams",
      "ValidateOutput",
      "ValidateOpError",
      "validateParamsSchema",
      "loadDiagram",
      "loadStylesheet",
      "loadTheme",
      "getBundledTheme",
      "ValidatorImpl",
      "ValidateRequest",
      "VisibilityFilterImpl",
      "StyleCascadeImpl",
      "TokenResolverImpl",
      "FilterRequest",
      "CascadeRequest",
      "ResolveTokensRequest"
    ]
  }
]
