file: "packages/ops/src/validate/validate_op_error.ts"
doc: "Boundary Error thrown out of validateOp.execute. Mirror RenderOpError in render/render_op_error.ts — same shape, different stage discriminator ('load' | 'validate' | 'filter' | 'cascade' | 'tokens')."

structs: [
  { name: "ValidateOpError"
    extends: ["Error"]
    doc:
      "Flattens typed-Result stage errors (LoadError | ValidateError | "
      "ResolveError) into one throwable so main.ts's catch block gets a real "
      ".message. Express the cause union as a type alias in the emitted file "
      "(spec models it as `unsupported` because TS union-at-type-position "
      "doesn't lift through textproto — Koine cascading-loss)."
    fields: [
      { name: "stage", type: { primitive: CHARACTER } },
      { name: "cause", type: { unsupported: { reason: UNION_AT_TYPE_POSITION } } }
    ]
    typescript: {}
  }
]
