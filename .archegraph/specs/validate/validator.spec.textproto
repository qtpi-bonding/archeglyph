file: "packages/core/src/validator/validator/impl.ts"
doc: "Validator capability — structural integrity checks on a Diagram. Single pass, accumulates ALL violations (don't bail on first), deterministic ordering."

interfaces: [
  { name: "Validator"
    doc:
      "Sync, pure function. Ok payload carries violations (may be empty or "
      "populated). Err is reserved for validator-itself failures (rare). Used "
      "by validateOp and eventually by the editor for live overlays."
    methods: [
      { name: "validate"
        inputs: [
          { name: "request", type: { named: { symbol: "ValidateRequest" } } }
        ]
        output: { named: { symbol: "archeglyph.util.Result", args: [
          { named: { symbol: "ValidateResponse" } },
          { named: { symbol: "ValidateError" } }
        ]}}
      }
    ]
    typescript: {}
  }
]

structs: [
  { name: "ValidatorImpl"
    implements: [{ named: { symbol: "Validator" } }]
    doc:
      "Four structural checks against diagram.graph in a single pass.\n"
      "\n"
      "Check 0, ID_KEY_MISMATCH: each element's own `id` equals the map key it\n"
      "is filed under. proto/content.proto states this as a MUST for nodes,\n"
      "edges and groups, and the rest of the system relies on it — the graph is\n"
      "keyed by id, edges reference nodes by id, stylesheets are keyed by id,\n"
      "and the renderer emits node.id as data-element-id. A mismatch fails\n"
      "silently rather than loudly: the element draws, but its styles never\n"
      "apply and it cannot be selected. Added 2026-09-11; the proto MUST had\n"
      "never been turned into a check, and design.md\u2019s rule list did not\n"
      "carry it either.\n"
      "\n"
      "The other three checks:\n"
      "  1. Edge.source / Edge.target reference existing Node.id.\n"
      "  2. Node.parent_group references existing Group.id (empty/undefined "
      "     means top-level; not a violation).\n"
      "  3. Group.parent_group: references existing Group.id AND the chain is "
      "     acyclic (DFS color marking — WHITE/GRAY/BLACK).\n"
      "\n"
      "Accumulate all violations into one list — don't bail on first. Sort the "
      "final list by (ViolationKind enum-declaration order, location string) "
      "for deterministic snapshots. Iterate all map keys via "
      "Object.keys(...).sort() per the established sorted-key pattern in "
      "visibility_filter/impl.ts (the canonical reference for sort-key "
      "discipline in this codebase).\n"
      "\n"
      "GROUP_CYCLE location format: comma-joined cycle path with the closing "
      "element repeated, e.g. 'a, b, c, a'."
    methods: [
      { name: "validate"
        inputs: [
          { name: "request", type: { named: { symbol: "ValidateRequest" } } }
        ]
        output: { named: { symbol: "archeglyph.util.Result", args: [
          { named: { symbol: "ValidateResponse" } },
          { named: { symbol: "ValidateError" } }
        ]}}
        uses: ["Violation", "ViolationKind"]
      }
    ]
    typescript: {}
  }
]
