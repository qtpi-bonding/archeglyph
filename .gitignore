node_modules
.bun-cache/
**/dist/
**/.bun-cache/

# archegraph code-graph artifacts (derived from source — high churn, regenerable)
.archegraph/gcode.pb
.archegraph/gcode.db
.archegraph/index.scip
# scip-typescript without --output puts index.scip at project root
/index.scip
# archegraph server runtime (per-process)
.archegraph/server.pid
.archegraph/server.port

# Spec-level derived/ artifacts (regenerable from .spec.textproto via `archegraph plan`; NOT tracked):
.archegraph/specs/*/derived/*
# ...except the testgen plan, which is NOT regenerable for free: it costs three
# LLM passes per symbol and is non-deterministic, so regenerating gives you
# different tests rather than the same ones back. The premise of the rule above
# does not hold for it. Note the trailing /* on the rule above: git cannot
# re-include a file whose parent DIRECTORY is excluded, so the exclusion has to
# name the contents.
!.archegraph/specs/*/derived/test_plan.textproto
# Legacy top-level derived artifacts (pre-derived/ convention) — still ignored:
.archegraph/specs/*/gcontract.pb
.archegraph/specs/*/gbuild_delta.pb
.archegraph/specs/*/gdrift_delta.pb
.archegraph/specs/*/gspec_delta.pb
.archegraph/specs/*/gcode_before.pb
.archegraph/specs/*/spec.md

# archebuild runtime (build server's per-project state)
.archebuild/

# Per-build history snapshots (transient, not durable contract artifacts)
.archegraph/builds/
.archegraph/specs/*/builds/
archebuild.db
archebuild.db-shm
archebuild.db-wal

# editor / build outputs (when they exist)
**/.vite/
**/.parcel-cache/

# OS / editor cruft
.DS_Store
*.swp
*~

# archegraph per-node build worktrees (transient; recreated by every build)
.claude/worktrees/
