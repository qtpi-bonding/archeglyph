{
  "name": "archeglyph",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "proto:gen": "buf generate",
    "proto:lint": "buf lint",
    "proto:format": "buf format -w",
    "archeglyph": "bun packages/cli/bin/archeglyph.ts",
    "typecheck": "tsc --noEmit",
    "spdx": "bun scripts/spdx.ts",
    "spdx:fix": "bun scripts/spdx.ts --fix",
    "build:editor": "bun run --filter @archeglyph/editor build",
    "dev:editor": "bun run --filter @archeglyph/editor dev",
    "test": "bun test --conditions browser --preload ./test/solid_preload.ts",
    "test:golden:update": "UPDATE_GOLDENS=1 bun test --conditions browser --preload ./test/solid_preload.ts test/golden_render.test.ts"
  },
  "devDependencies": {
    "@babel/core": "8.0.5",
    "@babel/preset-typescript": "8.0.1",
    "@bufbuild/protoc-gen-es": "^2.0.0",
    "@happy-dom/global-registrator": "20.14.5",
    "@rollup/rollup-darwin-x64": "4.63.1",
    "@solidjs/testing-library": "0.8.10",
    "@types/bun": "1.4.2",
    "@types/node": "^25.8.0",
    "@types/wicg-file-system-access": "^2023.10.7",
    "babel-preset-solid": "1.9.15",
    "fast-check": "4.10.1",
    "happy-dom": "20.14.5",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.12.0",
    "elkjs": "^0.9.3",
    "web-worker": "1.5.0"
  }
}
