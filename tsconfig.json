{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "lib": ["ES2022", "DOM"],
    "baseUrl": ".",
    "paths": {
      "@archeglyph/proto": ["./packages/proto/src/index.ts"],
      "@archeglyph/proto/util/result": ["./packages/proto/src/util/result.ts"],
      "@archeglyph/proto/gen/*": ["./packages/proto/src/gen/*.ts"]
    }
  },
  "include": ["packages/**/*.ts"]
}
